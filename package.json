{
  "name": "blazor-tw-ui",
  "version": "0.9.0",
  "private": true,
  "description": "Mobile-first Blazor WASM reusable component library with Tailwind CSS and Light/Dark/System theme support",
  "scripts": {
    "build:css": "npx tailwindcss -i ./wwwroot/css/input.css -o ./wwwroot/css/app.min.css --minify",
    "watch:css": "npx tailwindcss -i ./wwwroot/css/input.css -o ./wwwroot/css/app.min.css --watch",
    "build:dist": "dotnet publish BlazorTwUI.csproj -c Release -o dist",
    "tauri": "npx @tauri-apps/cli",
    "tauri:build": "npx @tauri-apps/cli build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "axe-core": "^4.14.0",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@zxing/library": "^0.23.0",
    "gridstack": "12.3.3",
    "jsqr": "^1.4.0",
    "playwright": "^1.64.1"
  }
}
