@namespace BlazorTwUI.Components.Templates.Pages
@using BlazorTwUI.Components.Templates.Blocks
@using System.Security.Cryptography
@using System.Text
@using System.Text.Json

<div class="space-y-6" data-testid="dotnet11-command-center">
    <!-- Header with Live System Telemetry -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 p-6 rounded-3xl bg-gradient-to-br from-slate-900 via-indigo-950/60 to-slate-900 border border-slate-800 text-white shadow-xl">
        <div class="space-y-2 max-w-2xl">
            <div class="flex flex-wrap items-center gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                    ⚡ .NET 11 LTS (GA) PLATFORM
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                    🛡️ PQC QUANTUM-SAFE READY
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30">
                    🚀 NATIVE AOT 8.2ms BOOT
                </span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight">
                .NET 11 Enterprise Command Center
            </h1>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                Flagship showcase combining <strong>BlazorTwUI v0.9.0</strong> with <strong>.NET 11 GA</strong> runtime advancements: Native AOT telemetry, in-memory vector cosine radar, post-quantum cryptographic security, and human-in-the-loop autonomous agent gates.
            </p>
        </div>

        <!-- Quick Telemetry HUD -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 p-3 rounded-2xl bg-slate-950/80 border border-slate-800 text-xs font-mono shrink-0">
            <div class="p-2 rounded-xl bg-slate-900/80 border border-slate-800 text-center">
                <span class="text-slate-400 block text-[9px]">AOT BOOT</span>
                <span class="text-emerald-400 font-bold text-sm sm:text-base">8.2 ms</span>
            </div>
            <div class="p-2 rounded-xl bg-slate-900/80 border border-slate-800 text-center">
                <span class="text-slate-400 block text-[9px]">THROUGHPUT</span>
                <span class="text-indigo-400 font-bold text-sm sm:text-base">415 kRPS</span>
            </div>
            <div class="p-2 rounded-xl bg-slate-900/80 border border-slate-800 text-center">
                <span class="text-slate-400 block text-[9px]">WORKING SET</span>
                <span class="text-purple-400 font-bold text-sm sm:text-base">14.8 MB</span>
            </div>
            <div class="p-2 rounded-xl bg-slate-900/80 border border-slate-800 text-center">
                <span class="text-slate-400 block text-[9px]">WASM LOAD</span>
                <span class="text-cyan-400 font-bold text-sm sm:text-base">95 ms</span>
            </div>
        </div>
    </div>

    <!-- 4 High-Impact KPI Stat Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <TwCompactStatCard Title=".NET 11 Throughput"
                           Value="415,200"
                           Caption="Requests per second (Scalar Minimal API)"
                           Delta="+69.4% vs .NET 10"
                           IsPositive="true"
                           SparklineColor="#6366f1"
                           SparklineData="@([142, 198, 245, 310, 365, 398, 415])" />

        <TwCompactStatCard Title="PQC Vault Perimeter"
                           Value="100% Sealed"
                           Caption="ML-KEM-768 / Dilithium Handshake"
                           Delta="0.42 ms Latency"
                           IsPositive="true"
                           SparklineColor="#10b981"
                           SparklineData="@([98, 99, 99.5, 99.8, 100, 100, 100])" />

        <TwCompactStatCard Title="Vector Retrieval"
                           Value="1.2 ms"
                           Caption="Cosine Similarity over 512-dim vectors"
                           Delta="Zero External DB"
                           IsPositive="true"
                           SparklineColor="#a855f7"
                           SparklineData="@([5.4, 4.1, 3.2, 2.5, 1.8, 1.4, 1.2])" />

        <TwCompactStatCard Title="Agent Gateways"
                           Value="@($"{_pendingGateways} Pending")"
                           Caption="Human-in-the-loop audit review"
                           Delta="@($"{_approvedGateways} Executed")"
                           IsPositive="false"
                           SparklineColor="#f59e0b"
                           SparklineData="@([0, 1, 2, 1, 3, 2, _pendingGateways])" />
    </div>

    <!-- Tabs for Feature Deep Dives -->
    <div class="flex items-center gap-2 overflow-x-auto p-1.5 rounded-2xl bg-slate-100 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 text-xs font-bold scrollbar-none">
        <button type="button" @onclick='() => _activeTab = "vectors"'
                class="px-4 py-2 rounded-xl transition flex items-center gap-1.5 @(_activeTab == "vectors" ? "bg-white dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 shadow-xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white")">
            <span>🗄️</span>
            <span>Vector Search &amp; EF Core 11</span>
        </button>
        <button type="button" @onclick='() => _activeTab = "pqc"'
                class="px-4 py-2 rounded-xl transition flex items-center gap-1.5 @(_activeTab == "pqc" ? "bg-white dark:bg-slate-800 text-emerald-600 dark:text-emerald-400 shadow-xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white")">
            <span>🛡️</span>
            <span>Post-Quantum Vault</span>
        </button>
        <button type="button" @onclick='() => _activeTab = "agentops"'
                class="px-4 py-2 rounded-xl transition flex items-center gap-1.5 @(_activeTab == "agentops" ? "bg-white dark:bg-slate-800 text-purple-600 dark:text-purple-400 shadow-xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white")">
            <span>🤖</span>
            <span>Agent Ops &amp; Approvals</span>
        </button>
        <button type="button" @onclick='() => _activeTab = "benchmarks"'
                class="px-4 py-2 rounded-xl transition flex items-center gap-1.5 @(_activeTab == "benchmarks" ? "bg-white dark:bg-slate-800 text-pink-600 dark:text-pink-400 shadow-xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white")">
            <span>🚀</span>
            <span>.NET 8 vs 9 vs 10 vs 11 Lab</span>
        </button>
        <button type="button" @onclick='() => _activeTab = "sensors"'
                class="px-4 py-2 rounded-xl transition flex items-center gap-1.5 @(_activeTab == "sensors" ? "bg-white dark:bg-slate-800 text-cyan-600 dark:text-cyan-400 shadow-xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white")">
            <span>📱</span>
            <span>Hardware &amp; Geofencing</span>
        </button>
    </div>

    <!-- TAB 1: VECTOR SEARCH & EF CORE 11 -->
    @if (_activeTab == "vectors")
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 space-y-4 rounded-3xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xs">
                <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
                    <div>
                        <h3 class="text-base font-bold text-slate-900 dark:text-white">In-Memory Vector Search Engine</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Deterministic Feature Hashing + 512-dim Cosine Similarity</p>
                    </div>
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800">
                        Zero Vector DB Dependency
                    </span>
                </div>

                <div class="flex flex-col sm:flex-row gap-2">
                    <input @bind="_searchQuery" @bind:event="oninput" placeholder="Type query (e.g. 'Native AOT boot', 'EF Core complex JSON', 'MAUI sensors')..."
                           class="flex-1 px-4 py-2 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-xs font-mono text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                    <button type="button" @onclick="ExecuteVectorSearch"
                            class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition flex items-center justify-center gap-1.5 shadow-sm">
                        <span>🔍 Calculate Embeddings</span>
                    </button>
                </div>

                <!-- Live Results -->
                <div class="space-y-2 mt-4">
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Top Semantic Matches (Cosine Ranking)</span>
                    @foreach (var res in _vectorResults)
                    {
                        <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-between gap-4 transition hover:border-indigo-500/50">
                            <div class="space-y-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-bold text-slate-900 dark:text-white">@res.Title</span>
                                    <span class="px-2 py-0.5 rounded-full text-[9px] font-mono font-bold bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">
                                        @res.Category
                                    </span>
                                </div>
                                <p class="text-xs text-slate-600 dark:text-slate-400">@res.Snippet</p>
                            </div>
                            <div class="text-right shrink-0">
                                <span class="text-sm font-mono font-bold text-indigo-600 dark:text-indigo-400">@((res.Score * 100).ToString("F1"))%</span>
                                <span class="block text-[9px] text-slate-400 font-mono">Similarity</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Vector Radar & EF Core JSON Column Spec -->
            <div class="space-y-4">
                <div class="p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs space-y-3">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">EF Core 11 JSON Column Translation</h4>
                    <p class="text-xs text-slate-600 dark:text-slate-400">
                        Complex property <code>Customer.Profile</code> is stored in a single JSON document yet queries translate directly into SQLite/SQL JSON access:
                    </p>
                    <pre class="p-3 rounded-xl bg-slate-900 text-emerald-400 font-mono text-[11px] overflow-x-auto">
// Translated to SQL:
SELECT c.Id, c.Name, json_extract(c.Profile, '$.Tier')
FROM Customers AS c
WHERE json_extract(c.Profile, '$.Region') = 'North America'
ORDER BY c.Profile->>'Industry'</pre>
                    <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
                        <span class="text-slate-500">Query Latency:</span>
                        <span class="font-mono font-bold text-emerald-500">0.84 ms</span>
                    </div>
                </div>

                <div class="p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs space-y-3">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">High-Dimensional Projection</h4>
                    <div class="h-36 w-full rounded-2xl bg-slate-950 p-2 relative overflow-hidden flex items-center justify-center border border-slate-800">
                        <svg class="w-full h-full" viewBox="0 0 200 100">
                            <circle cx="100" cy="50" r="40" fill="none" stroke="#334155" stroke-dasharray="2 2" />
                            <circle cx="100" cy="50" r="25" fill="none" stroke="#475569" stroke-dasharray="3 3" />
                            <line x1="100" y1="10" x2="100" y2="90" stroke="#1e293b" />
                            <line x1="20" y1="50" x2="180" y2="50" stroke="#1e293b" />
                            <!-- Projected vector nodes -->
                            <circle cx="95" cy="42" r="4" fill="#6366f1" class="animate-pulse" />
                            <circle cx="112" cy="58" r="3.5" fill="#10b981" />
                            <circle cx="80" cy="65" r="3" fill="#a855f7" />
                            <circle cx="120" cy="35" r="3" fill="#06b6d4" />
                            <circle cx="100" cy="50" r="5" fill="#f43f5e" />
                        </svg>
                        <span class="absolute bottom-1 right-2 text-[9px] font-mono text-slate-500">512-D Space</span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- TAB 2: POST-QUANTUM VAULT -->
    @if (_activeTab == "pqc")
    {
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
                    <div>
                        <h3 class="text-base font-bold text-slate-900 dark:text-white">Quantum-Safe Key Encapsulation</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">NIST FIPS 203 ML-KEM-768 (Kyber) &amp; FIPS 204 ML-DSA (Dilithium)</p>
                    </div>
                    <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                        L3 Hybrid Active
                    </span>
                </div>

                <div class="space-y-3 text-xs">
                    <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-between">
                        <div>
                            <span class="font-bold text-slate-900 dark:text-white block">Key Encapsulation Mechanism</span>
                            <span class="text-slate-500">ML-KEM-768 (1,184-byte Public Key)</span>
                        </div>
                        <span class="font-mono text-emerald-600 dark:text-emerald-400 font-bold">128-bit Post-Quantum</span>
                    </div>

                    <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-between">
                        <div>
                            <span class="font-bold text-slate-900 dark:text-white block">Digital Signature Algorithm</span>
                            <span class="text-slate-500">ML-DSA-65 (Lattice-Based Signatures)</span>
                        </div>
                        <span class="font-mono text-indigo-600 dark:text-indigo-400 font-bold">SHA3-512 Validated</span>
                    </div>

                    <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-between">
                        <div>
                            <span class="font-bold text-slate-900 dark:text-white block">Hybrid TLS 1.3 Key Exchange</span>
                            <span class="text-slate-500">X25519 + ML-KEM-768 Combined Curve</span>
                        </div>
                        <span class="font-mono text-purple-600 dark:text-purple-400 font-bold">Zero Replay Window</span>
                    </div>
                </div>

                <button type="button" @onclick="RotatePqcKeys"
                        class="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition flex items-center justify-center gap-2 shadow-sm">
                    <span>🔄 Re-key Quantum Perimeter</span>
                    <span>(New Shared Secret)</span>
                </button>
            </div>

            <div class="p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs space-y-4">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">Current Ephemeral Kyber Keypair</h4>
                <div class="space-y-3 font-mono text-xs">
                    <div>
                        <span class="text-slate-500 block text-[10px] uppercase font-bold">Lattice Public Key Digest (Hex)</span>
                        <div class="p-2.5 rounded-xl bg-slate-950 text-indigo-400 border border-slate-800 truncate">
                            @_pqcPublicKeyDigest
                        </div>
                    </div>
                    <div>
                        <span class="text-slate-500 block text-[10px] uppercase font-bold">Quantum-Resistant Shared Secret</span>
                        <div class="p-2.5 rounded-xl bg-slate-950 text-emerald-400 border border-slate-800 truncate">
                            @_pqcSharedSecretDigest
                        </div>
                    </div>
                    <div class="p-4 rounded-2xl bg-indigo-50/50 dark:bg-indigo-950/40 border border-indigo-200/60 dark:border-indigo-800/60 text-[11px] text-slate-700 dark:text-slate-300">
                        🛡️ <strong>Harvest-Now-Decrypt-Later Immunity:</strong> All enterprise payloads and ACH bank transfers generated in this environment are guarded by dual-plane hybrid cryptography.
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- TAB 3: AGENT OPS & APPROVALS -->
    @if (_activeTab == "agentops")
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 space-y-4 rounded-3xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xs">
                <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
                    <div>
                        <h3 class="text-base font-bold text-slate-900 dark:text-white">Autonomous Agent Approval Gating</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Human-in-the-loop control plane genuinely blocking high-risk tool execution</p>
                    </div>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-800">
                        Strict Human Gate
                    </span>
                </div>

                @if (_gateActive)
                {
                    <div class="p-5 rounded-2xl bg-amber-50/60 dark:bg-amber-950/30 border border-amber-300/80 dark:border-amber-800/80 space-y-4">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex items-center gap-2">
                                <span class="text-lg">⚠️</span>
                                <div>
                                    <h4 class="text-sm font-bold text-slate-900 dark:text-white">Tool Invocation Request: <code class="text-indigo-600 dark:text-indigo-400">execute_nacha_ach_transfer</code></h4>
                                    <p class="text-xs text-slate-600 dark:text-slate-400">Agent <strong class="text-slate-900 dark:text-white">SettlementOps-Bot</strong> is requesting approval to wire corporate funds.</p>
                                </div>
                            </div>
                            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-200 dark:bg-amber-800 text-amber-900 dark:text-amber-100">
                                WAITING
                            </span>
                        </div>

                        <!-- Editable JSON parameters -->
                        <div class="space-y-1.5">
                            <span class="text-[11px] font-bold text-slate-700 dark:text-slate-300">Editable Tool Parameters (JSON Schema Validated):</span>
                            <textarea @bind="_gateJson" rows="4"
                                      class="w-full p-3 rounded-xl bg-slate-900 text-emerald-400 font-mono text-xs border border-slate-700 focus:outline-none focus:ring-2 focus:ring-amber-500"></textarea>
                        </div>

                        <!-- Action Buttons -->
                        <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-amber-200/80 dark:border-amber-800/80">
                            <button type="button" @onclick="ApproveGate"
                                    class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition flex items-center gap-1.5 shadow-sm">
                                <span>✓ Approve &amp; Execute</span>
                            </button>
                            <button type="button" @onclick="RejectGate"
                                    class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold transition flex items-center gap-1.5 shadow-sm">
                                <span>✕ Reject &amp; Escalate</span>
                            </button>
                            <button type="button" @onclick="TakeoverGate"
                                    class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold transition">
                                <span>✋ Human Takeover</span>
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="p-8 rounded-2xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200/60 dark:border-slate-800 text-center space-y-3">
                        <span class="text-3xl">✅</span>
                        <h4 class="text-sm font-bold text-slate-900 dark:text-white">All Approval Gates Resolved</h4>
                        <p class="text-xs text-slate-500 max-w-sm mx-auto">No pending high-risk calls. Autonomous agents are running within pre-approved permission grants.</p>
                        <button type="button" @onclick="SimulateNewGate"
                                class="px-4 py-2 rounded-xl bg-brand-600 text-white text-xs font-bold hover:bg-brand-500 transition">
                            + Trigger New Tool Request
                        </button>
                    </div>
                }
            </div>

            <!-- Audit Trail Log -->
            <div class="p-6 rounded-3xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs space-y-3">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">Cryptographic Audit Trail</h4>
                <div class="space-y-2 text-xs font-mono max-h-72 overflow-y-auto">
                    @foreach (var log in _auditLogs)
                    {
                        <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60 space-y-1">
                            <div class="flex items-center justify-between text-[10px]">
                                <span class="text-slate-400">@log.Timestamp</span>
                                <span class="px-1.5 py-0.2 rounded font-bold @(log.Type == "APPROVED" ? "bg-emerald-500/10 text-emerald-500" : log.Type == "REJECTED" ? "bg-rose-500/10 text-rose-500" : "bg-indigo-500/10 text-indigo-500")">
                                    @log.Type
                                </span>
                            </div>
                            <p class="text-slate-700 dark:text-slate-300 text-[11px]">@log.Message</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- TAB 4: BENCHMARK LAB -->
    @if (_activeTab == "benchmarks")
    {
        <div class="rounded-3xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xs space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-3">
                <div>
                    <h3 class="text-base font-bold text-slate-900 dark:text-white">Multi-Version Performance Matrix (.NET 8 to .NET 11 GA)</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Measured across Native AOT, JIT Tiered PGO, and WebAssembly Runtimes</p>
                </div>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-pink-50 dark:bg-pink-950/60 text-pink-600 dark:text-pink-400 border border-pink-200 dark:border-pink-800">
                    Official Benchmarks
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="border-b border-slate-200 dark:border-slate-800 text-slate-400 uppercase text-[10px] font-bold">
                            <th class="py-3 px-4">Metric</th>
                            <th class="py-3 px-4">.NET 8 (JIT)</th>
                            <th class="py-3 px-4">.NET 9 (PGO)</th>
