@code {
    private string _activeTab = "vectors";
    private int _pendingGateways = 1;
    private int _approvedGateways = 14;

    // Vector search state
    private string _searchQuery = "Native AOT boot memory";
    private List<VectorResultItem> _vectorResults = new();

    // PQC state
    private string _pqcPublicKeyDigest = "f7c9e13a48bb2050e68d37aa9c218205f2b87431e67d3d19";
    private string _pqcSharedSecretDigest = "04ab92fe19cd882190ee418725bb7731a89c2409f87c1256";

    // Agent Gate state
    private bool _gateActive = true;
    private string _gateJson = "{\n  \"batch_id\": \"ACH-84920\",\n  \"amount_usd\": 1250000.00,\n  \"recipient\": \"Kyoto Edge Infrastructure LLC\",\n  \"auth_level\": \"Executive_L3\"\n}";
    private List<AuditLogItem> _auditLogs = new();

    // Sensors state
    private double _sensorX = 14.5;
    private double _sensorY = -8.2;
    private double _sensorZ = 45.0;
    private double _latitude = 47.6062;
    private double _longitude = -122.3321;
    private double _distanceMeters = 184.0;
    private bool _isInsideGeofence = true;

    protected override void OnInitialized()
    {
        ExecuteVectorSearch();
        _auditLogs.Add(new AuditLogItem { Timestamp = "11:24:02", Type = "APPROVED", Message = "Executed tool 'deploy_microservice_cluster' with validated schema." });
        _auditLogs.Add(new AuditLogItem { Timestamp = "11:20:15", Type = "SECURITY", Message = "Rotated ML-KEM-768 post-quantum keypair successfully." });
        _auditLogs.Add(new AuditLogItem { Timestamp = "11:15:40", Type = "APPROVED", Message = "EF Core 11 JSON document query verified." });
    }

    private void ExecuteVectorSearch()
    {
        var query = _searchQuery.ToLowerInvariant();
        _vectorResults = new List<VectorResultItem>
        {
            new() { Title = "Native AOT Minimal API Pipeline", Category = ".NET 11 Runtime", Snippet = "8.2 ms cold boot with 14.8 MB memory working set and zero JIT compilation overhead.", Score = query.Contains("aot") || query.Contains("boot") ? 0.96 : 0.82 },
            new() { Title = "EF Core 11 Complex JSON Columns", Category = "Data Architecture", Snippet = "Translated ToJson() LINQ queries directly running JSON extraction in SQLite & SQL Server.", Score = query.Contains("json") || query.Contains("ef") ? 0.94 : 0.78 },
            new() { Title = "Post-Quantum Cryptography Handshake", Category = "Security", Snippet = "Hybrid ML-KEM-768 and Dilithium key exchange protecting enterprise data in transit.", Score = query.Contains("pqc") || query.Contains("quantum") ? 0.95 : 0.74 },
            new() { Title = "MAUI Blazor Hybrid Sensor Bridges", Category = "Mobile & Devices", Snippet = "Direct hardware accelerometer, gyroscope and GPS geofencing telemetry bridges.", Score = query.Contains("sensor") || query.Contains("maui") ? 0.93 : 0.71 }
        }.OrderByDescending(r => r.Score).ToList();
    }

    private void RotatePqcKeys()
    {
        var randomBytes = new byte[24];
        RandomNumberGenerator.Fill(randomBytes);
        _pqcPublicKeyDigest = Convert.ToHexString(randomBytes).ToLowerInvariant();

        var secretBytes = new byte[24];
        RandomNumberGenerator.Fill(secretBytes);
        _pqcSharedSecretDigest = Convert.ToHexString(secretBytes).ToLowerInvariant();

        _auditLogs.Insert(0, new AuditLogItem { Timestamp = DateTime.Now.ToString("HH:mm:ss"), Type = "SECURITY", Message = "Rotated ML-KEM-768 post-quantum keypair successfully." });
    }

    private void ApproveGate()
    {
        _gateActive = false;
        _pendingGateways = 0;
        _approvedGateways++;
        _auditLogs.Insert(0, new AuditLogItem { Timestamp = DateTime.Now.ToString("HH:mm:ss"), Type = "APPROVED", Message = "Human approved 'execute_nacha_ach_transfer' for $1,250,000.00." });
    }

    private void RejectGate()
    {
        _gateActive = false;
        _pendingGateways = 0;
        _auditLogs.Insert(0, new AuditLogItem { Timestamp = DateTime.Now.ToString("HH:mm:ss"), Type = "REJECTED", Message = "Human rejected 'execute_nacha_ach_transfer'. Escalated to security incident desk." });
    }

    private void TakeoverGate()
    {
        _gateActive = false;
        _pendingGateways = 0;
        _auditLogs.Insert(0, new AuditLogItem { Timestamp = DateTime.Now.ToString("HH:mm:ss"), Type = "TAKEOVER", Message = "Human operator took manual control of agent session state." });
    }

    private void SimulateNewGate()
    {
        _gateActive = true;
        _pendingGateways = 1;
        _gateJson = "{\n  \"action\": \"database_schema_migrate\",\n  \"target_table\": \"CustomerProfiles_v11\",\n  \"dry_run\": false\n}";
    }

    private void SimulateSensorMotion()
    {
        var rand = new Random();
        _sensorX = rand.Next(-30, 30);
        _sensorY = rand.Next(-30, 30);
        _sensorZ = rand.Next(0, 360);
    }

    private void RandomizeLocation()
    {
        var rand = new Random();
        _distanceMeters = rand.Next(50, 800);
        _isInsideGeofence = _distanceMeters <= 500;
        _latitude = 47.6062 + (rand.NextDouble() - 0.5) * 0.01;
        _longitude = -122.3321 + (rand.NextDouble() - 0.5) * 0.01;
    }

    private class VectorResultItem
    {
        public string Title { get; set; } = "";
        public string Category { get; set; } = "";
        public string Snippet { get; set; } = "";
        public double Score { get; set; }
    }

    private class AuditLogItem
    {
        public string Timestamp { get; set; } = "";
        public string Type { get; set; } = "";
        public string Message { get; set; } = "";
    }
}
