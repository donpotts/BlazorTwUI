@namespace BlazorTwUI.Components.Templates.Pages
@using BlazorTwUI.Components.Templates.Blocks

<div class="space-y-16 sm:space-y-24">
    <!-- Kinetic Hero Section -->
    <TwLandingHero BadgeText="v1.0 Now Live • Pure WebAssembly"
                   Headline="One Platform. Infinite Enterprise Velocity."
                   Description="The mobile-first component engine and turnkey template system for Blazor WebAssembly and Tailwind CSS. Zero bloated dependencies, 100% native SVG analytics.">
        <ActionSlot>
            <button type="button" class="py-3 px-6 rounded-2xl text-xs sm:text-sm font-bold bg-brand-600 hover:bg-brand-700 text-white shadow-lg shadow-brand-600/30 transition hover:scale-[1.02]">
                Start Free Trial →
            </button>
            <button type="button" class="py-3 px-6 rounded-2xl text-xs sm:text-sm font-bold border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 transition">
                Explore Templates
            </button>
        </ActionSlot>

        <SocialProofSlot>
            <div class="flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400">
                <div class="flex -space-x-2">
                    <span class="inline-block h-7 w-7 rounded-full bg-indigo-500 ring-2 ring-white dark:ring-slate-900 flex items-center justify-center text-[10px] text-white font-bold">DP</span>
                    <span class="inline-block h-7 w-7 rounded-full bg-emerald-500 ring-2 ring-white dark:ring-slate-900 flex items-center justify-center text-[10px] text-white font-bold">AT</span>
                    <span class="inline-block h-7 w-7 rounded-full bg-purple-500 ring-2 ring-white dark:ring-slate-900 flex items-center justify-center text-[10px] text-white font-bold">JL</span>
                    <span class="inline-block h-7 w-7 rounded-full bg-amber-500 ring-2 ring-white dark:ring-slate-900 flex items-center justify-center text-[10px] text-white font-bold">CM</span>
                </div>
                <span>Loved by <strong>4,200+ engineers</strong> building modern .NET WebAssembly</span>
            </div>
        </SocialProofSlot>

        <PreviewSlot>
            <div class="p-4 sm:p-6 rounded-2xl bg-slate-950 text-white font-mono text-xs overflow-x-auto shadow-inner">
                <div class="flex items-center gap-2 pb-3 mb-3 border-b border-slate-800 text-slate-400 text-[11px]">
                    <span class="w-3 h-3 rounded-full bg-rose-500"></span>
                    <span class="w-3 h-3 rounded-full bg-amber-500"></span>
                    <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
                    <span class="ml-2 font-semibold text-slate-300">BlazorTwUI.TemplateEngine.cs</span>
                </div>
                <p class="text-emerald-400">// Instant turnkey composition with zero external charting runtimes</p>
                <p class="text-purple-300">@@using <span class="text-white">BlazorTwUI.Components.Templates.Pages</span></p>
                <p class="mt-2 text-indigo-300">&lt;<span class="text-amber-300">FintechAnalyticsDashboard</span> <span class="text-sky-300">LiquidityTarget</span>=<span class="text-emerald-300">"14.8M"</span> /&gt;</p>
                <p class="text-indigo-300">&lt;<span class="text-amber-300">AiOperationsTokenMonitor</span> <span class="text-sky-300">ApprovalGatesActive</span>=<span class="text-emerald-300">"true"</span> /&gt;</p>
            </div>
        </PreviewSlot>
    </TwLandingHero>

    <!-- Bento Features Matrix -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
            <span class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">Architectural Superpowers</span>
            <h2 class="mt-2 text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">Engineered for Production Scale</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="md:col-span-2 rounded-3xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 p-8 shadow-xs flex flex-col justify-between">
                <div>
                    <span class="w-10 h-10 rounded-2xl bg-brand-500/10 text-brand-600 flex items-center justify-center font-bold text-lg mb-4">📈</span>
                    <h3 class="text-xl font-bold text-slate-900 dark:text-white">Native SVG Analytics with Zero Canvas Overhead</h3>
                    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                        Say goodbye to bloated 500KB third-party charting libraries. Render trend lines, sparklines, and donuts using pure mathematical SVG calculations in C#.
                    </p>
                </div>
                <div class="mt-6 p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Memory footprint per chart:</span>
                    <span class="text-xs font-black text-emerald-600 dark:text-emerald-400">&lt; 12 KB (vs 540 KB legacy)</span>
                </div>
            </div>

            <div class="rounded-3xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 p-8 shadow-xs flex flex-col justify-between">
                <div>
                    <span class="w-10 h-10 rounded-2xl bg-purple-500/10 text-purple-600 flex items-center justify-center font-bold text-lg mb-4">🎨</span>
                    <h3 class="text-xl font-bold text-slate-900 dark:text-white">9-Palette Theme Engine</h3>
                    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                        Instant dark mode and 9 curated color presets with synchronous CSS custom property switching. Zero flash on navigation.
                    </p>
                </div>
                <div class="mt-6 flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-indigo-600 ring-2 ring-offset-2 ring-indigo-600"></span>
                    <span class="w-6 h-6 rounded-full bg-rose-500"></span>
                    <span class="w-6 h-6 rounded-full bg-emerald-500"></span>
                    <span class="w-6 h-6 rounded-full bg-amber-500"></span>
                    <span class="w-6 h-6 rounded-full bg-purple-600"></span>
                    <span class="text-xs font-bold text-slate-400 ml-2">+4 More</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Pricing Section Block -->
    <TwPricingSection Title="Simple, Transparent Enterprise Licensing"
                      Subtitle="Get full source code access, templates, and lifetime updates." />

    <!-- Testimonials Section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="rounded-3xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xs">
                <div class="flex items-center gap-1 text-amber-400 text-sm mb-3">★★★★★</div>
                <p class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed italic">
                    "The templates shaved three months off our enterprise portal rewrite. The native SVG charts and 1-click login pills blew our stakeholders away."
                </p>
                <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center gap-3">
                    <span class="w-8 h-8 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center text-xs">AT</span>
                    <div>
                        <div class="text-xs font-bold text-slate-900 dark:text-white">Alex Taylor</div>
                        <div class="text-[10px] text-slate-400">Chief Architect, FinEdge Solutions</div>
                    </div>
                </div>
            </div>

            <div class="rounded-3xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xs">
                <div class="flex items-center gap-1 text-amber-400 text-sm mb-3">★★★★★</div>
                <p class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed italic">
                    "Finally, an enterprise component library with zero bloated JS dependencies. Mobile cards and touch support are genuinely first-class."
                </p>
                <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center gap-3">
                    <span class="w-8 h-8 rounded-full bg-emerald-600 text-white font-bold flex items-center justify-center text-xs">JL</span>
                    <div>
                        <div class="text-xs font-bold text-slate-900 dark:text-white">Jordan Lee</div>
                        <div class="text-[10px] text-slate-400">Principal Engineer, CloudFleet</div>
                    </div>
                </div>
            </div>

            <div class="rounded-3xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xs">
                <div class="flex items-center gap-1 text-amber-400 text-sm mb-3">★★★★★</div>
                <p class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed italic">
                    "The Agent Ops approval gates and telemetry monitor gave our AI workflow complete human-in-the-loop compliance out of the box."
                </p>
                <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center gap-3">
                    <span class="w-8 h-8 rounded-full bg-purple-600 text-white font-bold flex items-center justify-center text-xs">CM</span>
                    <div>
                        <div class="text-xs font-bold text-slate-900 dark:text-white">Casey Morgan</div>
                        <div class="text-[10px] text-slate-400">Head of Engineering, RoboVentures</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
