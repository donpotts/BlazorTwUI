@namespace BlazorTwUI.Components.Templates.Blocks

<div class="py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto">
            <span class="text-xs font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400">@BadgeText</span>
            <h2 class="mt-2 text-3xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white">@Title</h2>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="mt-4 text-base text-slate-600 dark:text-slate-400">@Subtitle</p>
            }

            <!-- Billing Toggle -->
            <div class="mt-8 inline-flex items-center gap-3 p-1 rounded-2xl bg-slate-100 dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80">
                <button type="button" @onclick="() => SetAnnual(false)"
                        class="px-4 py-1.5 rounded-xl text-xs font-bold transition-all duration-200 @(!_isAnnual ? "bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white")">
                    Monthly
                </button>
                <button type="button" @onclick="() => SetAnnual(true)"
                        class="px-4 py-1.5 rounded-xl text-xs font-bold transition-all duration-200 flex items-center gap-1.5 @(_isAnnual ? "bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs" : "text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white")">
                    <span>Annual</span>
                    <span class="px-1.5 py-0.5 rounded-md text-[10px] font-extrabold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">Save 20%</span>
                </button>
            </div>
        </div>

        <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
            @foreach (var plan in Plans)
            {
                var price = _isAnnual ? plan.AnnualMonthlyEquivalent : plan.MonthlyPrice;
                var isPop = plan.IsPopular;

                <div class="relative flex flex-col justify-between rounded-3xl p-7 transition-all duration-300 @(isPop ? "border-2 border-brand-500 bg-white dark:bg-slate-900 shadow-xl shadow-brand-500/10 ring-4 ring-brand-500/10" : "border border-slate-200/80 dark:border-slate-800 bg-white/60 dark:bg-slate-900/60 shadow-xs hover:border-slate-300 dark:hover:border-slate-700")">
                    @if (isPop)
                    {
                        <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full text-[11px] font-black uppercase tracking-wider bg-brand-600 text-white shadow-md shadow-brand-600/30">
                            Most Popular
                        </div>
                    }

                    <div>
                        <div class="flex items-center justify-between">
                            <h3 class="text-lg font-bold text-slate-900 dark:text-white">@plan.Name</h3>
                            @if (!string.IsNullOrEmpty(plan.Badge))
                            {
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">@plan.Badge</span>
                            }
                        </div>
                        <p class="mt-2 text-xs text-slate-500 dark:text-slate-400 leading-relaxed min-h-[36px]">@plan.Description</p>

                        <div class="mt-6 flex items-baseline gap-1">
                            <span class="text-4xl font-black text-slate-900 dark:text-white">@price</span>
                            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">/ seat / month</span>
                        </div>
                        @if (_isAnnual && plan.BilledAnnuallyText is not null)
                        {
                            <div class="mt-1 text-[11px] text-emerald-600 dark:text-emerald-400 font-medium">@plan.BilledAnnuallyText</div>
                        }

                        <ul class="mt-8 space-y-3">
                            @foreach (var feature in plan.Features)
                            {
                                <li class="flex items-start gap-2.5 text-xs text-slate-700 dark:text-slate-300">
                                    <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                    </svg>
                                    <span>@feature</span>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="mt-8 pt-4">
                        <button type="button" @onclick="() => OnSelectPlan.InvokeAsync(plan)"
                                class="w-full py-2.5 px-4 rounded-xl text-xs font-bold transition-all duration-200 @(isPop ? "bg-brand-600 hover:bg-brand-700 text-white shadow-md shadow-brand-600/25" : "border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-900 dark:text-white")">
                            @plan.ButtonText
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string BadgeText { get; set; } = "Simple Pricing";
    [Parameter] public string Title { get; set; } = "Predictable Plans for Every Stage";
    [Parameter] public string? Subtitle { get; set; } = "Start with a risk-free trial. Upgrade or cancel anytime.";
    [Parameter] public List<PricingPlan> Plans { get; set; } = GetDefaultPlans();
    [Parameter] public EventCallback<PricingPlan> OnSelectPlan { get; set; }

    private bool _isAnnual = true;

    private void SetAnnual(bool annual) => _isAnnual = annual;

    public class PricingPlan
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string MonthlyPrice { get; set; } = string.Empty;
        public string AnnualMonthlyEquivalent { get; set; } = string.Empty;
        public string? BilledAnnuallyText { get; set; }
        public string? Badge { get; set; }
        public bool IsPopular { get; set; }
        public string ButtonText { get; set; } = "Get Started";
        public List<string> Features { get; set; } = new();
    }

    private static List<PricingPlan> GetDefaultPlans() =>
    [
        new()
        {
            Id = "starter",
            Name = "Starter",
            Description = "Essential features for growing teams and pilot rollouts.",
            MonthlyPrice = "$29",
            AnnualMonthlyEquivalent = "$24",
            BilledAnnuallyText = "Billed annually ($288/yr)",
            ButtonText = "Start Free Trial",
            Features =
            [
                "Up to 5 Team Members",
                "Full Relational Data Access",
                "Pure SVG Interactive Charts",
                "Export to Excel & PDF",
                "Community Support"
            ]
        },
        new()
        {
            Id = "pro",
            Name = "Professional",
            Description = "Advanced velocity and governance for expanding businesses.",
            MonthlyPrice = "$79",
            AnnualMonthlyEquivalent = "$64",
            BilledAnnuallyText = "Billed annually ($768/yr)",
            IsPopular = true,
            Badge = "Recommended",
            ButtonText = "Launch Pro",
            Features =
            [
                "Unlimited Team Members",
                "Dynamic 9-Palette Theme Engine",
                "Live Telemetry & Audit Trails",
                "1-Click Role Claim Testing",
                "Priority 24/7 Support",
                "Custom Domain SSL"
            ]
        },
        new()
        {
            Id = "enterprise",
            Name = "Enterprise",
            Description = "Dedicated performance, custom security, and compliance.",
            MonthlyPrice = "$199",
            AnnualMonthlyEquivalent = "$159",
            BilledAnnuallyText = "Billed annually ($1,908/yr)",
            Badge = "High Security",
            ButtonText = "Contact Sales",
            Features =
            [
                "Single Sign-On (SAML / OIDC)",
                "Audit Log Compliance Streaming",
                "Dedicated Private Cluster",
                "99.99% Uptime Guarantee",
                "Custom Contract Agreements",
                "Dedicated Solutions Architect"
            ]
        }
    ];
}
