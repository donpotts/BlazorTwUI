@namespace BlazorTwUI.Components.Templates.Blocks

<div class="@(Class ?? "py-8 sm:py-12")">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header -->
        <div class="text-center max-w-2xl mx-auto">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-50 dark:bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-200/80 dark:border-brand-500/20">
                <span>⚡</span>
                <span>@BadgeText</span>
            </span>
            <h2 class="mt-3 text-3xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white">@Title</h2>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">@Subtitle</p>
            }

            <!-- Billing Cycle Pill Switcher -->
            <div class="mt-8 inline-flex items-center gap-1.5 p-1.5 rounded-2xl bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 shadow-xs">
                <button type="button" @onclick="() => SetAnnual(false)"
                        class="px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 @(!_isAnnual ? "bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs" : "text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white")">
                    Monthly billing
                </button>
                <button type="button" @onclick="() => SetAnnual(true)"
                        class="px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 flex items-center gap-2 @(_isAnnual ? "bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-xs" : "text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white")">
                    <span>Annual billing</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/25">
                        Save 20%
                    </span>
                </button>
            </div>
        </div>

        <!-- 3-Tier Grid Matrix -->
        <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
            @foreach (var plan in Plans)
            {
                var price = _isAnnual ? plan.AnnualMonthlyEquivalent : plan.MonthlyPrice;
                var isPop = plan.IsPopular;

                <div class="relative flex flex-col justify-between rounded-3xl p-7 sm:p-8 transition-all duration-300 @(isPop ? "bg-white dark:bg-slate-900 border-2 border-brand-500 shadow-xl shadow-brand-500/10 ring-4 ring-brand-500/10 md:-translate-y-2 z-10" : "bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border border-slate-200/80 dark:border-slate-800 shadow-xs hover:shadow-md hover:border-slate-300 dark:hover:border-slate-700")">
                    @if (isPop)
                    {
                        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
                            <span class="inline-flex items-center gap-1.5 px-4 py-1 rounded-full text-[11px] font-black uppercase tracking-wider bg-gradient-to-r from-brand-600 to-indigo-600 text-white shadow-md shadow-brand-500/30 ring-2 ring-white dark:ring-slate-900">
                                <span>★</span>
                                <span>Most Popular</span>
                            </span>
                        </div>
                    }

                    <!-- Top Content Area -->
                    <div>
                        <!-- Plan Header -->
                        <div class="flex items-center justify-between min-h-[28px]">
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white">@plan.Name</h3>
                            @if (!string.IsNullOrEmpty(plan.Badge) && !isPop)
                            {
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
                                    @plan.Badge
                                </span>
                            }
                        </div>

                        <!-- Description (Fixed min-height for baseline alignment across cards) -->
                        <div class="mt-2 text-xs text-slate-500 dark:text-slate-400 leading-relaxed min-h-[36px] flex items-center">
                            @plan.Description
                        </div>

                        <!-- Price Readout with Fixed-Height Annual Note (Zero Layout Shift) -->
                        <div class="mt-6 pt-6 border-t border-slate-100 dark:border-slate-800/80">
                            <div class="flex items-baseline gap-1.5">
                                <span class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">@price</span>
                                <span class="text-xs font-semibold text-slate-400">/ seat / month</span>
                            </div>
                            <div class="h-6 mt-1.5 flex items-center">
                                @if (_isAnnual && plan.BilledAnnuallyText is not null)
                                {
                                    <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-600 dark:text-emerald-400">
                                        <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                        </svg>
                                        <span>@plan.BilledAnnuallyText</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-[11px] text-slate-400 font-medium">Billed monthly, cancel anytime</span>
                                }
                            </div>
                        </div>

                        <!-- Features Checklist -->
                        <div class="mt-6 pt-6 border-t border-slate-100 dark:border-slate-800/80">
                            <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-4">What's included</p>
                            <ul class="space-y-3">
                                @foreach (var feature in plan.Features)
                                {
                                    <li class="flex items-center gap-3 text-xs text-slate-700 dark:text-slate-300">
                                        <div class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                                            <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                            </svg>
                                        </div>
                                        <span class="font-medium">@feature</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    <!-- Call-to-Action Action Button (Consistent 44px min touch target height) -->
                    <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-800/80">
                        <button type="button" @onclick="() => OnSelectPlan.InvokeAsync(plan)"
                                class="w-full h-11 px-5 rounded-xl text-xs font-bold transition-all duration-200 flex items-center justify-center gap-2 @(isPop ? "bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-500 hover:to-indigo-500 text-white shadow-lg shadow-brand-500/25 hover:scale-[1.01]" : "border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 shadow-xs hover:border-slate-300")">
                            <span>@plan.ButtonText</span>
                            @if (isPop)
                            {
                                <span>→</span>
                            }
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string BadgeText { get; set; } = "Simple Pricing";
    [Parameter] public string Title { get; set; } = "Predictable Plans for Every Stage";
    [Parameter] public string? Subtitle { get; set; } = "Start with a risk-free trial. Upgrade or cancel anytime.";
    [Parameter] public string? Class { get; set; }
    [Parameter] public List<PricingPlan> Plans { get; set; } = GetDefaultPlans();
    [Parameter] public EventCallback<PricingPlan> OnSelectPlan { get; set; }

    private bool _isAnnual = true;

    private void SetAnnual(bool annual) => _isAnnual = annual;

    public class PricingPlan
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string MonthlyPrice { get; set; } = string.Empty;
        public string AnnualMonthlyEquivalent { get; set; } = string.Empty;
        public string? BilledAnnuallyText { get; set; }
        public string? Badge { get; set; }
        public bool IsPopular { get; set; }
        public string ButtonText { get; set; } = "Get Started";
        public List<string> Features { get; set; } = new();
    }

    private static List<PricingPlan> GetDefaultPlans() =>
    [
        new()
        {
            Id = "starter",
            Name = "Starter",
            Description = "Essential features for growing teams and pilot rollouts.",
            MonthlyPrice = "$29",
            AnnualMonthlyEquivalent = "$24",
            BilledAnnuallyText = "Billed annually ($288/yr)",
            ButtonText = "Start Free Trial",
            Features =
            [
                "Up to 5 Team Members",
                "Full Relational Data Access",
                "Pure SVG Interactive Charts",
                "Standard DataGrid & Export",
                "9-Palette Theme Support",
                "Community & Docs Support"
            ]
        },
        new()
        {
            Id = "pro",
            Name = "Professional",
            Description = "Advanced velocity and governance for expanding businesses.",
            MonthlyPrice = "$79",
            AnnualMonthlyEquivalent = "$64",
            BilledAnnuallyText = "Billed annually ($768/yr)",
            IsPopular = true,
            ButtonText = "Launch Pro",
            Features =
            [
                "Unlimited Team Members",
                "Dynamic 9-Palette Theme Engine",
                "Live Telemetry & Audit Trails",
                "1-Click Role Claim Testing",
                "Priority 24/7 SLAs",
                "Custom Domain SSL & CDN"
            ]
        },
        new()
        {
            Id = "enterprise",
            Name = "Enterprise",
            Description = "Dedicated performance, custom security, and compliance.",
            MonthlyPrice = "$199",
            AnnualMonthlyEquivalent = "$159",
            BilledAnnuallyText = "Billed annually ($1,908/yr)",
            Badge = "High Security",
            ButtonText = "Contact Sales",
            Features =
            [
                "Single Sign-On (SAML / OIDC)",
                "Audit Log Compliance Streaming",
                "Dedicated Private Cluster",
                "99.99% Uptime SLA Guarantee",
                "Custom Security Review & DPA",
                "Dedicated Solutions Architect"
            ]
        }
    ];
}
