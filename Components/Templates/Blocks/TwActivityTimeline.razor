@namespace BlazorTwUI.Components.Templates.Blocks

<div class="rounded-3xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-xs">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">@Title</h3>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">@Subtitle</p>
            }
        </div>
        @if (HeaderActionSlot is not null)
        {
            @HeaderActionSlot
        }
    </div>

    @if (Events is { Count: > 0 })
    {
        <div class="relative pl-6 space-y-6 before:absolute before:left-2.5 before:top-2 before:bottom-2 before:w-0.5 before:bg-slate-200 dark:before:bg-slate-800">
            @foreach (var ev in Events)
            {
                var dotColor = ev.Status switch
                {
                    TimelineStatus.Success => "bg-emerald-500 ring-emerald-500/20",
                    TimelineStatus.Warning => "bg-amber-500 ring-amber-500/20",
                    TimelineStatus.Danger => "bg-rose-500 ring-rose-500/20",
                    _ => "bg-indigo-500 ring-indigo-500/20"
                };

                <div class="relative group">
                    <span class="absolute -left-6 top-1.5 w-2.5 h-2.5 rounded-full @dotColor ring-4"></span>
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <div class="text-xs font-bold text-slate-900 dark:text-white">@ev.Title</div>
                            @if (!string.IsNullOrEmpty(ev.Description))
                            {
                                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5 leading-relaxed">@ev.Description</p>
                            }
                            @if (!string.IsNullOrEmpty(ev.Tag))
                            {
                                <span class="inline-block mt-1.5 px-2 py-0.5 rounded-md text-[10px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                                    @ev.Tag
                                </span>
                            }
                        </div>
                        <span class="text-[10px] font-semibold text-slate-400 shrink-0">@ev.Timestamp</span>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="py-8 text-center text-xs text-slate-400">No activity logged yet.</div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Audit & Event Activity";
    [Parameter] public string? Subtitle { get; set; } = "Real-time system events and governance trace";
    [Parameter] public RenderFragment? HeaderActionSlot { get; set; }
    [Parameter] public List<TimelineEvent> Events { get; set; } = new();

    public enum TimelineStatus
    {
        Info,
        Success,
        Warning,
        Danger
    }

    public class TimelineEvent
    {
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string? Tag { get; set; }
        public string Timestamp { get; set; } = string.Empty;
        public TimelineStatus Status { get; set; } = TimelineStatus.Info;
    }
}
