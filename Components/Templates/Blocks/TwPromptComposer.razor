@namespace BlazorTwUI.Components.Templates.Blocks

<div class="relative rounded-3xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900 p-3 shadow-lg shadow-slate-900/5 transition duration-200 focus-within:border-brand-500/80 focus-within:ring-4 focus-within:ring-brand-500/10">
    @if (SuggestedPrompts is { Count: > 0 })
    {
        <div class="flex flex-wrap items-center gap-1.5 px-2 pt-1 pb-3 border-b border-slate-100 dark:border-slate-800/80">
            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Suggestions:</span>
            @foreach (var prompt in SuggestedPrompts)
            {
                <button type="button" @onclick="() => SelectSuggestion(prompt)"
                        class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 hover:bg-brand-50 dark:hover:bg-brand-500/10 hover:text-brand-600 dark:hover:text-brand-400 text-slate-700 dark:text-slate-300 transition">
                    @prompt
                </button>
            }
        </div>
    }

    <div class="mt-2 px-2">
        <textarea @bind="_promptText"
                  @bind:event="oninput"
                  @onkeydown="HandleKeyDown"
                  rows="@Rows"
                  placeholder="@Placeholder"
                  class="w-full resize-none bg-transparent text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none leading-relaxed"></textarea>
    </div>

    <div class="mt-2 flex items-center justify-between gap-2 px-1 pt-2 border-t border-slate-100 dark:border-slate-800/80">
        <div class="flex items-center gap-1.5 text-slate-400">
            <button type="button" title="Attach context file" class="p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-700 dark:hover:text-slate-200 transition">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                </svg>
            </button>
            <button type="button" title="Voice dictation" class="p-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-700 dark:hover:text-slate-200 transition">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                </svg>
            </button>
        </div>

        <div class="flex items-center gap-2">
            <span class="hidden sm:inline-block text-[11px] text-slate-400 font-medium">Shift + Enter for new line</span>
            <button type="button" @onclick="Submit"
                    disabled="@(string.IsNullOrWhiteSpace(_promptText) || IsLoading)"
                    class="inline-flex items-center gap-1.5 py-1.5 px-4 rounded-xl text-xs font-bold transition-all duration-200 disabled:opacity-40 disabled:cursor-not-allowed bg-brand-600 hover:bg-brand-700 text-white shadow-xs">
                @if (IsLoading)
                {
                    <span class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                    <span>Synthesizing...</span>
                }
                else
                {
                    <span>Generate</span>
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Placeholder { get; set; } = "Ask an enterprise agent or describe an adaptive UI component...";
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public List<string>? SuggestedPrompts { get; set; }
    [Parameter] public EventCallback<string> OnSend { get; set; }

    private string _promptText = string.Empty;

    private void SelectSuggestion(string suggestion)
    {
        _promptText = suggestion;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await Submit();
        }
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_promptText) || IsLoading) return;
        var text = _promptText;
        _promptText = string.Empty;
        await OnSend.InvokeAsync(text);
    }
}
