@namespace BlazorTwUI.Components.Templates.Blocks

<div class="group relative overflow-hidden rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-xs hover:border-brand-500/50 hover:shadow-md transition-all duration-300">
    <div class="flex items-center justify-between gap-2">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">@Title</span>
        @if (!string.IsNullOrEmpty(Delta))
        {
            <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold @(IsPositive ? "bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/60" : "bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 border border-rose-200/60 dark:border-rose-800/60")">
                <span>@(IsPositive ? "↑" : "↓")</span>
                <span>@Delta</span>
            </div>
        }
    </div>

    <div class="mt-3 flex items-baseline justify-between gap-4">
        <div>
            <div class="text-3xl font-black tracking-tight text-slate-900 dark:text-white">@Value</div>
            @if (!string.IsNullOrEmpty(Caption))
            {
                <div class="mt-1 text-xs font-medium text-slate-500 dark:text-slate-400">@Caption</div>
            }
        </div>

        @if (SparklineData is { Count: > 1 })
        {
            var max = SparklineData.Max();
            var min = SparklineData.Min();
            var range = max - min;
            if (range <= 0) range = 1.0;
            var w = 110.0;
            var h = 38.0;
            var pts = string.Join(" ", SparklineData.Select((v, i) =>
                $"{(i * w / (SparklineData.Count - 1)):0.#},{h - ((v - min) / range * (h - 8) + 4):0.#}"));

            <div class="w-24 h-10 flex-shrink-0">
                <svg viewBox="0 0 110 38" class="w-full h-full overflow-visible">
                    <polyline fill="none" stroke="@SparklineColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" points="@pts" />
                </svg>
            </div>
        }
    </div>

    @if (ChildContent is not null)
    {
        <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string? Caption { get; set; }
    [Parameter] public string? Delta { get; set; }
    [Parameter] public bool IsPositive { get; set; } = true;
    [Parameter] public List<double>? SparklineData { get; set; }
    [Parameter] public string SparklineColor { get; set; } = "#10b981";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
