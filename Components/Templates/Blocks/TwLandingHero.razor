@namespace BlazorTwUI.Components.Templates.Blocks

<div class="relative overflow-hidden pt-12 pb-20 sm:pt-16 sm:pb-28">
    <!-- Ambient Background Blur Glow -->
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[720px] h-[360px] bg-gradient-to-tr from-brand-500/20 via-indigo-500/15 to-purple-500/20 blur-3xl pointer-events-none rounded-full" aria-hidden="true"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto">
            @if (!string.IsNullOrEmpty(BadgeText))
            {
                <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-brand-50 dark:bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-200/80 dark:border-brand-500/20 shadow-xs mb-6 hover:scale-105 transition duration-200">
                    <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
                    <span>@BadgeText</span>
                </div>
            }

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.12]">
                @if (HeadlineTemplate is not null)
                {
                    @HeadlineTemplate
                }
                else
                {
                    @Headline
                }
            </h1>

            @if (!string.IsNullOrEmpty(Description))
            {
                <p class="mt-6 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
                    @Description
                </p>
            }

            @if (ActionSlot is not null)
            {
                <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
                    @ActionSlot
                </div>
            }

            @if (SocialProofSlot is not null)
            {
                <div class="mt-10 pt-6 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-center">
                    @SocialProofSlot
                </div>
            }
        </div>

        @if (PreviewSlot is not null)
        {
            <div class="mt-14 max-w-5xl mx-auto">
                <div class="relative rounded-3xl border border-slate-200/80 dark:border-slate-800 bg-white/70 dark:bg-slate-900/70 p-2 sm:p-4 backdrop-blur-xl shadow-2xl shadow-slate-900/10 dark:shadow-black/50">
                    @PreviewSlot
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? BadgeText { get; set; }
    [Parameter] public string Headline { get; set; } = string.Empty;
    [Parameter] public RenderFragment? HeadlineTemplate { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? ActionSlot { get; set; }
    [Parameter] public RenderFragment? SocialProofSlot { get; set; }
    [Parameter] public RenderFragment? PreviewSlot { get; set; }
}
