@implements IDisposable

<div class="@TwMerge.Merge("relative inline-block", Classes?.Base, Class)"
     @onmouseenter="HandleMouseEnter"
     @onmouseleave="HandleMouseLeave"
     @onfocusin="HandleMouseEnter"
     @onfocusout="HandleMouseLeave">
    <div class="@TwMerge.Merge("inline-flex items-center cursor-pointer", Classes?.Trigger)">
        @TriggerContent
    </div>

    @if (_isOpen || IsOpen)
    {
        <div class="@ComputedCardClasses"
             @onmouseenter="HandleMouseEnter"
             @onmouseleave="HandleMouseLeave">
            <!-- Invisible hover bridge so moving cursor from trigger to card never drops hover -->
            <div class="absolute -inset-3 bg-transparent -z-10 pointer-events-auto"></div>
            @if (ShowArrow)
            {
                <div class="@ComputedArrowClasses"></div>
            }
            <div class="relative z-10">
                @ChildContent
            </div>
        </div>
    }
</div>

@code {
    private bool _isOpen;
    private CancellationTokenSource? _cts;

    [Parameter] public RenderFragment? TriggerContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public TwPopoverPlacement Placement { get; set; } = TwPopoverPlacement.Bottom;
    [Parameter] public int OpenDelayMs { get; set; } = 120;
    [Parameter] public int CloseDelayMs { get; set; } = 220;
    [Parameter] public bool ShowArrow { get; set; } = true;
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public TwHoverCardSlots? Classes { get; set; }

    private async Task HandleMouseEnter()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        try
        {
            if (!_isOpen && OpenDelayMs > 0)
                await Task.Delay(OpenDelayMs, token);
            if (!token.IsCancellationRequested)
            {
                _isOpen = true;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }

    private async Task HandleMouseLeave()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        try
        {
            if (CloseDelayMs > 0)
                await Task.Delay(CloseDelayMs, token);
            if (!token.IsCancellationRequested)
            {
                _isOpen = false;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }

    private string ComputedCardClasses
    {
        get
        {
            var pos = Placement switch
            {
                TwPopoverPlacement.Top => "bottom-full left-1/2 -translate-x-1/2 mb-2.5",
                TwPopoverPlacement.TopStart => "bottom-full left-0 mb-2.5",
                TwPopoverPlacement.TopEnd => "bottom-full right-0 mb-2.5",
                TwPopoverPlacement.BottomStart => "top-full left-0 mt-2.5",
                TwPopoverPlacement.BottomEnd => "top-full right-0 mt-2.5",
                TwPopoverPlacement.Left => "right-full top-1/2 -translate-y-1/2 mr-2.5",
                TwPopoverPlacement.Right => "left-full top-1/2 -translate-y-1/2 ml-2.5",
                _ => "top-full left-1/2 -translate-x-1/2 mt-2.5"
            };

            return TwMerge.Merge(
                $"absolute z-50 w-80 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 text-slate-900 dark:text-slate-100 shadow-xl outline-none transition-all duration-150 {pos}",
                Classes?.Content);
        }
    }

    private string ComputedArrowClasses
    {
        get
        {
            var arrowPos = Placement switch
            {
                TwPopoverPlacement.Top or TwPopoverPlacement.TopStart or TwPopoverPlacement.TopEnd => "-bottom-1.5 left-6 border-b border-r",
                TwPopoverPlacement.Left => "-right-1.5 top-1/2 -translate-y-1/2 border-t border-r",
                TwPopoverPlacement.Right => "-left-1.5 top-1/2 -translate-y-1/2 border-b border-l",
                _ => "-top-1.5 left-6 border-t border-l"
            };
            return TwMerge.Merge(
                $"absolute w-3 h-3 rotate-45 bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 {arrowPos}",
                Classes?.Arrow);
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
