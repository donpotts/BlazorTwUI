    private string GetToggleFormattingClasses() =>
        TwClassBuilder.Create("transition-all duration-150")
            .AddIf(_selectedFormatting.Contains("bold"), "font-black text-slate-900 dark:text-white")
            .AddIf(_selectedFormatting.Contains("italic"), "italic underline decoration-amber-500")
            .AddIf(_selectedFormatting.Contains("code"), "font-mono bg-indigo-500/15 px-2 py-0.5 rounded border border-indigo-500/30 text-indigo-400")
            .Build();

    private void HandleMenubarCommand(TwMenubar.MenubarItem item)
    {
        _lastMenubarAction = item.Label;
        switch (item.Label)
        {
            case "Expand Toast Stack":
                _expandToastStack = item.Checked;
                break;
            case "Show HoverCard Arrows":
                _showHoverCardArrows = item.Checked;
                break;
            case "Undo Slot Override":
                SetCardSlotPreset("default");
                _customMergeOverride = "rounded-full px-8 bg-emerald-600 hover:bg-emerald-500 shadow-lg";
                break;
            case "Run TwMerge Optimizer":
                SetCardSlotPreset("cyber");
                _customMergeOverride = "rounded-none px-12 py-4 bg-amber-400 text-slate-950 font-black shadow-2xl";
                break;
            case "Export TwSlots JSON":
                _activeMockupKind = MockupKind.Code;
                break;
            case "New Studio Tab":
                _activeMockupKind = MockupKind.Browser;
                break;
        }
    }

    private void SendChatBubble()
    {
        if (string.IsNullOrWhiteSpace(_newChatMessage))
            return;

        _chatMessages.Add(new DemoChatMessage
        {
            Sender = "You (Live E2E Action)",
            Initials = "E2",
            Timestamp = DateTime.Now.ToString("HH:mm"),
            IsEnd = true,
            Variant = SemanticVariant.Success,
            Message = _newChatMessage.Trim(),
            FooterStatus = "Delivered via Live TwSwap Composer"
        });
        _newChatMessage = string.Empty;
    }

    private void SetCardSlotPreset(string preset)
    {
        _cardSlotPreset = preset;
        _activeCardSlots = preset switch
        {
            "cyber" => new TwCardSlots
            {
                Base = "border-2 border-indigo-500/60 shadow-xl shadow-indigo-500/10",
                Header = "bg-gradient-to-r from-indigo-950/90 via-slate-900 to-purple-950/90 text-white border-b border-indigo-500/30",
                Title = "text-amber-300 font-black tracking-tight",
                Subtitle = "text-indigo-200"
            },
            "emerald" => new TwCardSlots
            {
                Base = "border-2 border-emerald-500/50 shadow-xl shadow-emerald-500/10",
                Header = "bg-emerald-950/10 dark:bg-emerald-950/50 border-b border-emerald-500/20",
                Title = "text-emerald-600 dark:text-emerald-400 font-black"
            },
            _ => null
        };
    }
