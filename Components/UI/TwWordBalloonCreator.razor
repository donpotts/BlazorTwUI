@code {
    [Parameter] public string Class { get; set; } = "";

    public string MainWord { get; set; } = "KABOOM!";
    public string KickerText { get; set; } = "ACTION #1";
    public double WordScale { get; set; } = 1.25;
    public int SurroundingWordCount { get; set; } = 11;
    public double SurroundingWordScale { get; set; } = 1.0;
    public double WordTiltAngle { get; set; } = 0;

    // Mode 2 Anchored Callouts
    public bool AvatarCalloutPinned { get; set; } = true;
    public TwPopoverTrigger DemoOverlayTrigger { get; set; } = TwPopoverTrigger.Hover;

    // Balloon Backdrop Visibility & Resize Capability
    public bool ShowBackdropShape { get; set; } = true;
    public bool AutoResizeBalloon { get; set; } = true;

    public void ToggleBackdropShape()
    {
        ShowBackdropShape = !ShowBackdropShape;
    }
    public double BalloonScale { get; set; } = 1.35;
    public double BalloonPaddingX { get; set; } = 42.0;
    public double BalloonPaddingY { get; set; } = 22.0;
    public double BalloonCustomWidth { get; set; } = 0.0;
    public double BalloonCustomHeight { get; set; } = 0.0;

    public void ToggleAutoResize()
    {
        AutoResizeBalloon = !AutoResizeBalloon;
        if (!AutoResizeBalloon && BalloonCustomWidth <= 0)
        {
            BalloonCustomWidth = 260.0;
        }
    }

    public void SetBalloonScale(double scale)
    {
        BalloonScale = scale;
    }

    public void ShrinkBalloon()
    {
        BalloonScale = Math.Max(0.7, Math.Round((BalloonScale - 0.1) * 100.0) / 100.0);
    }

    public void EnlargeBalloon()
    {
        BalloonScale = Math.Min(2.8, Math.Round((BalloonScale + 0.1) * 100.0) / 100.0);
    }

    public WordBalloonShape SelectedShape { get; set; } = WordBalloonShape.ComicBurst;
    public WordBalloonEffect SelectedEffect { get; set; } = WordBalloonEffect.PowEffect;
    public WordBalloonTheme SelectedTheme { get; set; } = WordBalloonTheme.ComicYellow;
    public WordBalloonTailPosition SelectedTailPosition { get; set; } = WordBalloonTailPosition.BottomLeft;
    public WordBalloonTailStyle SelectedTailStyle { get; set; } = WordBalloonTailStyle.Wedge;

    // Overlays
    public bool MasterOverlaysEnabled { get; set; } = true;
    public bool ShowSpeedSunburst { get; set; } = true;
    public bool ShowHalftoneDots { get; set; } = true;
    public bool ShowActionSparks { get; set; } = true;
    public bool ShowSpecularSheen { get; set; } = false;
    public bool ShowScanlineHud { get; set; } = false;

    public bool AnimatePulse { get; set; } = true;
    public bool ShowSpiralWords => SurroundingWordCount > 0;
    public bool CenterWordOnTop { get; set; } = true;
    public string CurrentPreset { get; set; } = "POW";
    public string ActiveMode { get; set; } = "canvas";

    private bool _copyConfirmed = false;
    private bool _downloadConfirmed = false;
    private string _downloadedFilename = "";

    private static readonly string[] SurpriseWords =
    {
        "KABOOM!", "POW!", "BLAZOR WASM", "AI AGENT", "HYPER-SPEED", "FULL-STACK C#",
        "TURBO SVE2", "QUANTUM ML", "SUPERHERO!", "INFINITY", "NATIVE AOT", "ZERO LATENCY"
    };

