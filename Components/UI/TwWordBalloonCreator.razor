@namespace BlazorTwUI.Components.UI
@using BlazorTwUI.Models
@using System.Globalization
@using System.Text
@inject IJSRuntime JS

<div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm space-y-6 @Class">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 dark:border-slate-800 pb-4">
        <div>
            <div class="flex items-center gap-2 flex-wrap">
                <span class="text-xl">💥</span>
                <h3 class="text-base font-bold text-slate-900 dark:text-white tracking-tight">
                    Word Balloon & Comic Banner Creator
                </h3>
                <span class="px-2 py-0.5 text-[10px] font-mono font-bold rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                    SVG + PNG Engine
                </span>
                <span class="px-2 py-0.5 text-[10px] font-mono font-bold rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20">
                    Zero CDN
                </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                Customize word balloons, comic bursts, speech callouts, visual overlays (sunburst, halftone, sparks), or toggle off all extras for a clean normal balloon.
            </p>
        </div>

        <!-- 1-Click Action Buttons -->
        <div class="flex items-center gap-2 flex-wrap">
            <button type="button"
                    @onclick="SetCleanNormalBalloon"
                    class="px-3 py-1.5 rounded-xl border border-emerald-300 dark:border-emerald-700 bg-emerald-50 dark:bg-emerald-950/40 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300 text-xs font-bold flex items-center gap-1.5 transition-colors shadow-xs"
                    title="Turn off all extras and show a clean normal word balloon with center word on top">
                <span>💬</span> Clean Normal Balloon
            </button>
            <button type="button"
                    @onclick="RandomizeWord"
                    class="px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-750 text-slate-700 dark:text-slate-200 text-xs font-semibold flex items-center gap-1.5 transition-colors">
                <span>🎲</span> Randomize
            </button>
            <button type="button"
                    @onclick="CopySvgMarkup"
                    class="px-3 py-1.5 rounded-xl border border-indigo-200 dark:border-indigo-800/60 bg-indigo-50/50 dark:bg-indigo-950/30 hover:bg-indigo-100 dark:hover:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300 text-xs font-semibold flex items-center gap-1.5 transition-colors">
                <span>📋</span> @(_copyConfirmed ? "Copied SVG!" : "Copy SVG")
            </button>
            <button type="button"
                    @onclick="ExportPngFile"
                    class="px-3 py-1.5 rounded-xl border border-purple-200 dark:border-purple-800 bg-purple-50 dark:bg-purple-950/40 hover:bg-purple-100 dark:hover:bg-purple-900/40 text-purple-700 dark:text-purple-300 text-xs font-semibold flex items-center gap-1.5 transition-colors">
                <span>🖼️</span> Export PNG
            </button>
            <button type="button"
                    @onclick="ExportSvgFile"
                    class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-indigo-600 to-brand-600 hover:from-indigo-500 hover:to-brand-500 text-white text-xs font-semibold flex items-center gap-1.5 shadow-xs transition-all">
                <span>📥</span> Export SVG
            </button>
        </div>
    </div>

    <!-- Quick Preset Kits -->
    <div class="space-y-2">
        <div class="flex items-center justify-between">
            <label class="text-[11px] font-bold uppercase tracking-wider text-slate-400">
                Quick Preset Kits:
            </label>
            <span class="text-[11px] text-slate-400">8 High-Impact Themes & Layouts</span>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <button type="button"
                    @onclick="SetCleanNormalBalloon"
                    class="px-3 py-1 rounded-xl text-xs font-bold transition-all @(CurrentPreset == "NORMAL" ? "bg-emerald-600 text-white shadow-sm ring-2 ring-emerald-500/30" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-750")">
                💬 Clean Normal Balloon
            </button>
            <button type="button"
                    @onclick='() => ApplyPreset("POW", WordBalloonShape.ComicBurst, WordBalloonEffect.PowEffect, WordBalloonTheme.ComicYellow, "KABOOM!", true, true, 11, true, true, true, false, false, "ACTION #1")'
                    class="px-3 py-1 rounded-xl text-xs font-bold transition-all @(CurrentPreset == "POW" ? "bg-amber-500 text-slate-950 shadow-sm" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-750")">
                💥 Superhero POW!
            </button>
            <button type="button"
                    @onclick='() => ApplyPreset("THOUGHT", WordBalloonShape.ThoughtBubble, WordBalloonEffect.Bold, WordBalloonTheme.SunsetBlaze, "HMM... THINKING", false, true, 8, false, false, false, true, false, "IDEA")'
                    class="px-3 py-1 rounded-xl text-xs font-bold transition-all @(CurrentPreset == "THOUGHT" ? "bg-pink-600 text-white shadow-sm" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-750")">
                💭 Deep Thought
            </button>
            <button type="button"
                    @onclick='() => ApplyPreset("CYBER", WordBalloonShape.CyberHexagon, WordBalloonEffect.GlitchEffect, WordBalloonTheme.CyberCyan, "NEURAL NET", false, true, 14, false, false, false, false, true, "SYS_OK")'
                    class="px-3 py-1 rounded-xl text-xs font-bold transition-all @(CurrentPreset == "CYBER" ? "bg-cyan-500 text-slate-950 shadow-sm" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-750")">
                ⚡ Cyber Glitch
            </button>
            <button type="button"
                    @onclick='() => ApplyPreset("CHROME", WordBalloonShape.PillCapsule, WordBalloonEffect.GradientChrome, WordBalloonTheme.EmeraldTech, "SVE2 SIMD", false, true, 9, false, false, false, true, false, "TURBO")'
                    class="px-3 py-1 rounded-xl text-xs font-bold transition-all @(CurrentPreset == "CHROME" ? "bg-emerald-600 text-white shadow-sm" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-750")">
                🪞 Metallic Chrome
            </button>
            <button type="button"
                    @onclick='() => ApplyPreset("SHIELD", WordBalloonShape.BadgeShield, WordBalloonEffect.Outlined, WordBalloonTheme.GoldenHero, "ENTERPRISE", false, true, 10, true, false, true, true, false, "PRO TIER")'
                    class="px-3 py-1 rounded-xl text-xs font-bold transition-all @(CurrentPreset == "SHIELD" ? "bg-amber-600 text-white shadow-sm" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-750")">
                🛡️ Hero Shield
            </button>
            <button type="button"
                    @onclick='() => ApplyPreset("RIBBON", WordBalloonShape.BannerRibbon, WordBalloonEffect.FireFlame, WordBalloonTheme.CrimsonBurst, "CRITICAL HIT", true, true, 12, true, false, true, false, false, "LVL 99")'
                    class="px-3 py-1 rounded-xl text-xs font-bold transition-all @(CurrentPreset == "RIBBON" ? "bg-rose-600 text-white shadow-sm" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-750")">
                🎗️ Action Banner
            </button>
            <button type="button"
                    @onclick='() => ApplyPreset("ARCADE", WordBalloonShape.RetroArcade, WordBalloonEffect.Retro3D, WordBalloonTheme.NeonMatrix, "BONUS STAGE", false, true, 10, false, true, false, false, true, "1UP")'
                    class="px-3 py-1 rounded-xl text-xs font-bold transition-all @(CurrentPreset == "ARCADE" ? "bg-green-600 text-white shadow-sm" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-750")">
                👾 8-Bit Arcade
            </button>
        </div>
    </div>

    <!-- Mode Switcher: Studio Canvas vs Anchored UI Callout Overlays -->
    <div class="flex items-center gap-2 border-b border-slate-100 dark:border-slate-800 pb-2">
        <button type="button"
                @onclick='() => ActiveMode = "canvas"'
                class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @(ActiveMode == "canvas" ? "bg-indigo-600 text-white shadow-sm" : "text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800")">
            <span>🎨</span> Vector Studio Canvas
        </button>
        <button type="button"
                @onclick='() => ActiveMode = "overlays"'
                class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @(ActiveMode == "overlays" ? "bg-indigo-600 text-white shadow-sm" : "text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800")">
            <span>🎯</span> Interactive UI Callout Overlays
            <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-white/20">Live</span>
        </button>
    </div>

    <!-- Mode 1: Vector Studio Canvas View -->
    @if (ActiveMode == "canvas")
    {
        <div class="relative">
            <TwWordCloud Words="CurrentCloudWords"
                         BalloonShape="SelectedShape"
                         BalloonEffect="SelectedEffect"
                         BalloonTheme="SelectedTheme"
                         TailPosition="SelectedTailPosition"
                         TailStyle="SelectedTailStyle"
                         AutoResizeBalloon="AutoResizeBalloon"
                         BalloonScale="BalloonScale"
                         BalloonPaddingX="BalloonPaddingX"
                         BalloonPaddingY="BalloonPaddingY"
                         BalloonCustomWidth="BalloonCustomWidth"
                         BalloonCustomHeight="BalloonCustomHeight"
                         ShowSpeedSunburst="MasterOverlaysEnabled && ShowSpeedSunburst"
                         ShowHalftoneDots="MasterOverlaysEnabled && ShowHalftoneDots"
                         ShowActionSparks="MasterOverlaysEnabled && ShowActionSparks"
                         ShowSpecularSheen="MasterOverlaysEnabled && ShowSpecularSheen"
                         ShowScanlineHud="MasterOverlaysEnabled && ShowScanlineHud"
                         KickerText="@(MasterOverlaysEnabled ? KickerText : null)"
                         TextRotationAngle="WordTiltAngle"
                         AnimatePulse="AnimatePulse"
                         CenterWordScale="WordScale"
                         SurroundingWordCount="SurroundingWordCount"
                         SurroundingWordScale="SurroundingWordScale"
                         CenterWordOnTop="CenterWordOnTop"
                         ShowCenterBalloon="ShowBackdropShape"
                         ShowSpiralWords="ShowSpiralWords"
                         Title="" />

            @if (_copyConfirmed)
            {
                <div class="absolute top-4 right-4 bg-emerald-600 text-white text-xs font-bold px-3 py-1 rounded-xl shadow-lg animate-fadeIn flex items-center gap-1.5">
                    <span>✓</span> SVG Markup Copied!
                </div>
            }
            @if (_downloadConfirmed)
            {
                <div class="absolute top-4 right-4 bg-indigo-600 text-white text-xs font-bold px-3 py-1 rounded-xl shadow-lg animate-fadeIn flex items-center gap-1.5">
                    <span>✓</span> File Exported (@_downloadedFilename)
                </div>
            }
        </div>
    }
    else
    {
        <!-- Mode 2: Interactive UI Callout Overlays Live Showcase -->
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-850 border border-slate-200 dark:border-slate-800 space-y-6">
            <div class="flex items-center justify-between">
                <div>
                    <h4 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <span>🎯</span> Anchored UI Word Balloon Overlays
                    </h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        The Word Balloon acts as an anchored callout / popover floating over avatars, metric cards, or buttons with directional tails.
                    </p>
                </div>
                <button type="button" @onclick="CopyBlazorSnippet"
                        class="px-2.5 py-1 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-200 flex items-center gap-1">
                    <span>💻</span> Copy Blazor Component Tag
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
                <!-- 1. Character Avatar with Speech Balloon -->
                <div class="p-5 pt-16 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex flex-col items-center justify-center text-center space-y-3 min-h-[220px] relative">
                    <div class="flex items-center justify-between absolute top-3 left-4 right-4">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">1. Avatar Callout</span>
                        <button type="button" @onclick="() => AvatarCalloutPinned = !AvatarCalloutPinned"
                                class="text-[10px] font-semibold px-2 py-0.5 rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all">
                            @(AvatarCalloutPinned ? "📌 Pinned" : "👆 Hover")
                        </button>
                    </div>
                    <TwWordBalloonOverlay Text="@MainWord"
                                          Kicker="@(MasterOverlaysEnabled ? KickerText : null)"
                                          Shape="SelectedShape"
                                          Theme="SelectedTheme"
                                          Effect="SelectedEffect"
                                          Placement="TwPopoverPlacement.Top"
                                          IsOpen="true"
                                          Persistent="AvatarCalloutPinned"
                                          Trigger="TwPopoverTrigger.Hover"
                                          Interactive="true"
                                          ShowSheen="ShowSpecularSheen"
                                          AnimatePulse="AnimatePulse"
                                          Scale="WordScale"
                                          AutoResizeBalloon="AutoResizeBalloon"
                                          BalloonScale="BalloonScale"
                                          PaddingX="BalloonPaddingX"
                                          PaddingY="BalloonPaddingY">
                        <div class="w-14 h-14 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-600 p-0.5 shadow-md flex items-center justify-center cursor-pointer transition-transform hover:scale-105">
                            <div class="w-full h-full rounded-full bg-white dark:bg-slate-900 flex items-center justify-center text-2xl">
                                🦸
                            </div>
                        </div>
                    </TwWordBalloonOverlay>
                    <span class="text-xs font-bold text-slate-800 dark:text-slate-200">Blazor Hero</span>
                </div>

                <!-- 2. KPI Metric Card Surge Callout -->
                <div class="p-5 pt-16 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex flex-col justify-between space-y-3 min-h-[220px] relative">
                    <div class="flex items-center justify-between absolute top-3 left-4 right-4">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">2. KPI Metric Shout</span>
                        <span class="text-xs">📈</span>
                    </div>
                    <div class="space-y-1 relative pt-4">
                        <TwWordBalloonOverlay Text="💥 SURGE +42%"
                                              Kicker="NEW PEAK"
                                              Shape="WordBalloonShape.ComicBurst"
                                              Theme="WordBalloonTheme.CrimsonBurst"
                                              Effect="WordBalloonEffect.PowEffect"
                                              Placement="TwPopoverPlacement.Top"
                                              IsOpen="true"
                                              Persistent="true"
                                              Interactive="true"
                                              Scale="0.85">
                            <div class="text-2xl font-mono font-black text-slate-900 dark:text-white">$148,250</div>
                        </TwWordBalloonOverlay>
                        <p class="text-[11px] text-slate-500">Quarterly Recurring Revenue</p>
                    </div>
                    <div class="text-[10px] text-emerald-600 dark:text-emerald-400 font-bold">✓ Target Exceeded</div>
                </div>

                <!-- 3. Interactive Target Button (Hover / Click Trigger) -->
                <div class="p-5 pt-16 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex flex-col items-center justify-center text-center space-y-3 min-h-[220px] relative">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 absolute top-3 left-4">3. Interactive Target Trigger</span>
                    <TwWordBalloonOverlay Text="HOVERED / ACTIVE!"
                                          Shape="SelectedShape"
                                          Theme="SelectedTheme"
                                          Effect="SelectedEffect"
                                          Trigger="DemoOverlayTrigger"
                                          Placement="TwPopoverPlacement.Top"
                                          Interactive="true"
                                          CloseDelayMs="250"
                                          Scale="1.0">
                        <button type="button"
                                class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs shadow-md transition-all">
                            @(DemoOverlayTrigger == TwPopoverTrigger.Click ? "Click Me" : "Hover Over Me")
                        </button>
                    </TwWordBalloonOverlay>
                    <div class="flex items-center gap-1.5 mt-2">
                        <button type="button"
                                @onclick="() => DemoOverlayTrigger = TwPopoverTrigger.Hover"
                                class="px-2 py-0.5 rounded text-[10px] font-semibold transition-all @(DemoOverlayTrigger == TwPopoverTrigger.Hover ? "bg-indigo-600 text-white shadow-xs" : "bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-300 dark:hover:bg-slate-700")">
                            Hover Mode
                        </button>
                        <button type="button"
                                @onclick="() => DemoOverlayTrigger = TwPopoverTrigger.Click"
                                class="px-2 py-0.5 rounded text-[10px] font-semibold transition-all @(DemoOverlayTrigger == TwPopoverTrigger.Click ? "bg-indigo-600 text-white shadow-xs" : "bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-300 dark:hover:bg-slate-700")">
                            Click Mode
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Controls Studio Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-4 border-t border-slate-100 dark:border-slate-800">
        
        <!-- Column 1: Text, Word Count Slider & Scale -->
        <div class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
                    Main Center Word:
                </label>
                <div class="relative">
                    <input type="text"
                           @bind="MainWord"
                           @bind:event="oninput"
                           maxlength="28"
                           placeholder="Enter center word..."
                           class="w-full px-3.5 py-2 rounded-xl text-sm font-bold bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-hidden focus:ring-2 focus:ring-indigo-500 dark:text-white" />
                    <span class="absolute right-3 top-2.5 text-[10px] font-mono text-slate-400">
                        @MainWord.Length/28
                    </span>
                </div>
            </div>

            <!-- Kicker / Caption Overlay Text -->
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
                    Kicker Badge / Sub-Caption:
                </label>
                <input type="text"
                       @bind="KickerText"
                       @bind:event="oninput"
                       maxlength="16"
                       placeholder="e.g. WHAM!, ISSUE #1, NEW!"
                       class="w-full px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 focus:outline-hidden focus:ring-2 focus:ring-indigo-500 dark:text-white" />
            </div>

            <!-- Surrounding Words Count Slider (Increase or Decrease!) -->
            <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 space-y-2">
                <div class="flex justify-between items-center text-xs font-bold text-slate-700 dark:text-slate-300">
                    <span class="flex items-center gap-1.5">
                        <span>☁️</span> Surrounding Words Count:
                    </span>
                    <span class="font-mono text-indigo-600 dark:text-indigo-400 font-bold">
                        @(SurroundingWordCount == 0 ? "0 (Clean Balloon)" : $"{SurroundingWordCount} words")
                    </span>
                </div>
                <input type="range"
                       min="0"
                       max="25"
                       step="1"
                       @bind="SurroundingWordCount"
                       @bind:event="oninput"
                       class="w-full accent-indigo-600 cursor-pointer" />
                <div class="flex justify-between text-[10px] text-slate-400">
                    <span>0 (None / Clean)</span>
                    <span>12 (Balanced)</span>
                    <span>25 (Dense Cloud)</span>
                </div>
            </div>

            <!-- Center Word Size Scale Slider -->
            <div>
                <div class="flex justify-between items-center text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
                    <span>Center Word Size:</span>
                    <span class="font-mono text-indigo-600 dark:text-indigo-400">@(Math.Round(WordScale * 42))px (@WordScale.ToString("F2")x)</span>
                </div>
                <input type="range"
                       min="0.6"
                       max="2.0"
                       step="0.05"
                       @bind="WordScale"
                       @bind:event="oninput"
                       class="w-full accent-indigo-600 cursor-pointer" />
            </div>

            <!-- Surrounding Words Size Slider -->
            @if (SurroundingWordCount > 0)
            {
                <div>
                    <div class="flex justify-between items-center text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
                        <span>Surrounding Words Scale:</span>
                        <span class="font-mono text-indigo-600 dark:text-indigo-400">@SurroundingWordScale.ToString("F2")x</span>
                    </div>
                    <input type="range"
                           min="0.5"
                           max="1.8"
                           step="0.05"
                           @bind="SurroundingWordScale"
                           @bind:event="oninput"
                           class="w-full accent-indigo-600 cursor-pointer" />
                </div>
            }

            <!-- Tilt / Rotation Slider -->
            <div>
                <div class="flex justify-between items-center text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5">
                    <span>Word Tilt Angle:</span>
                    <span class="font-mono text-indigo-600 dark:text-indigo-400">@WordTiltAngle°</span>
                </div>
                <input type="range"
                       min="-15"
                       max="15"
                       step="1"
                       @bind="WordTiltAngle"
                       @bind:event="oninput"
                       class="w-full accent-indigo-600 cursor-pointer" />
            </div>

            <!-- Core Toggles -->
            <div class="space-y-2 pt-1">
                <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-800 dark:text-slate-200">
                    <input type="checkbox"
                           @bind="CenterWordOnTop"
                           class="rounded-sm border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                    <span>Always Paint Center Word On Top</span>
                </label>

                <label class="flex items-center gap-2 cursor-pointer text-xs font-medium text-slate-700 dark:text-slate-300">
                    <input type="checkbox"
                           @bind="AnimatePulse"
                           class="rounded-sm border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                    <span>Action Pulse & Bounce Animation</span>
                </label>
            </div>
        </div>

        <!-- Column 2: Shapes & Tail Options -->
        <div class="space-y-4">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                        Balloon Backdrop Shape:
                    </label>
                    <button type="button"
                            @onclick="ToggleBackdropShape"
                            class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold transition-all @(ShowBackdropShape ? "bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30" : "bg-rose-500/20 text-rose-600 dark:text-rose-400 border border-rose-500/30")"
                            title="Turn Balloon Backdrop Shape ON or OFF">
                        @(ShowBackdropShape ? "SHAPE: ON" : "SHAPE: OFF (Hidden)")
                    </button>
                </div>
                <div class="grid grid-cols-2 gap-1.5 max-h-[220px] overflow-y-auto p-1 border border-slate-100 dark:border-slate-800 rounded-xl">
                    <button type="button"
                            @onclick="() => SelectedShape = WordBalloonShape.SpeechBubble"
                            class="px-2.5 py-1.5 rounded-lg text-xs font-semibold border text-left flex items-center gap-1.5 transition-all @(SelectedShape == WordBalloonShape.SpeechBubble ? "border-indigo-600 bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 font-bold" : "border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300")">
                        <span>💬</span> Speech Bubble
                    </button>
                    <button type="button"
                            @onclick="() => SelectedShape = WordBalloonShape.SmoothCallout"
                            class="px-2.5 py-1.5 rounded-lg text-xs font-semibold border text-left flex items-center gap-1.5 transition-all @(SelectedShape == WordBalloonShape.SmoothCallout ? "border-indigo-600 bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 font-bold" : "border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300")">
                        <span>🗨️</span> Smooth Callout
                    </button>
                    <button type="button"
                            @onclick="() => SelectedShape = WordBalloonShape.ThoughtBubble"
                            class="px-2.5 py-1.5 rounded-lg text-xs font-semibold border text-left flex items-center gap-1.5 transition-all @(SelectedShape == WordBalloonShape.ThoughtBubble ? "border-pink-500 bg-pink-50 dark:bg-pink-950/40 text-pink-600 dark:text-pink-400 font-bold" : "border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300")">
                        <span>💭</span> Thought Bubble
                    </button>
                    <button type="button"
                            @onclick="() => SelectedShape = WordBalloonShape.PillCapsule"
                            class="px-2.5 py-1.5 rounded-lg text-xs font-semibold border text-left flex items-center gap-1.5 transition-all @(SelectedShape == WordBalloonShape.PillCapsule ? "border-indigo-600 bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 font-bold" : "border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300")">
                        <span>💊</span> Pill Capsule
                    </button>
                    <button type="button"
                            @onclick="() => SelectedShape = WordBalloonShape.ComicBurst"
                            class="px-2.5 py-1.5 rounded-lg text-xs font-semibold border text-left flex items-center gap-1.5 transition-all @(SelectedShape == WordBalloonShape.ComicBurst ? "border-amber-500 bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 font-bold" : "border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300")">
                        <span>💥</span> Starburst (POW)
                    </button>
                    <button type="button"
                            @onclick="() => SelectedShape = WordBalloonShape.ActionBlast"
                            class="px-2.5 py-1.5 rounded-lg text-xs font-semibold border text-left flex items-center gap-1.5 transition-all @(SelectedShape == WordBalloonShape.ActionBlast ? "border-red-500 bg-red-50 dark:bg-red-950/40 text-red-600 dark:text-red-400 font-bold" : "border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300")">
                        <span>⚡</span> Action Blast
                    </button>
                    <button type="button"
                            @onclick="() => SelectedShape = WordBalloonShape.BadgeShield"
                            class="px-2.5 py-1.5 rounded-lg text-xs font-semibold border text-left flex items-center gap-1.5 transition-all @(SelectedShape == WordBalloonShape.BadgeShield ? "border-amber-500 bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 font-bold" : "border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300")">
                        <span>🛡️</span> Hero Shield
                    </button>
                    <button type="button"
                            @onclick="() => SelectedShape = WordBalloonShape.BannerRibbon"
                            class="px-2.5 py-1.5 rounded-lg text-xs font-semibold border text-left flex items-center gap-1.5 transition-all @(SelectedShape == WordBalloonShape.BannerRibbon ? "border-rose-500 bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 font-bold" : "border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300")">
                        <span>🎗️</span> Ribbon Banner
                    </button>
                    <button type="button"
                            @onclick="() => SelectedShape = WordBalloonShape.CyberHexagon"
                            class="px-2.5 py-1.5 rounded-lg text-xs font-semibold border text-left flex items-center gap-1.5 transition-all @(SelectedShape == WordBalloonShape.CyberHexagon ? "border-cyan-500 bg-cyan-50 dark:bg-cyan-950/40 text-cyan-600 dark:text-cyan-400 font-bold" : "border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300")">
                        <span>⬡</span> Cyber Hexagon
                    </button>
                    <button type="button"
                            @onclick="() => SelectedShape = WordBalloonShape.CloudPuff"
                            class="px-2.5 py-1.5 rounded-lg text-xs font-semibold border text-left flex items-center gap-1.5 transition-all @(SelectedShape == WordBalloonShape.CloudPuff ? "border-slate-500 bg-slate-50 dark:bg-slate-950/40 text-slate-800 dark:text-slate-200 font-bold" : "border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300")">
                        <span>☁️</span> Cloud Puff
                    </button>
                    <button type="button"
                            @onclick="() => SelectedShape = WordBalloonShape.RetroArcade"
                            class="px-2.5 py-1.5 rounded-lg text-xs font-semibold border text-left flex items-center gap-1.5 col-span-2 transition-all @(SelectedShape == WordBalloonShape.RetroArcade ? "border-green-500 bg-green-50 dark:bg-green-950/40 text-green-600 dark:text-green-400 font-bold" : "border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300")">
                        <span>👾</span> Retro Arcade Pixel Box
                    </button>
                </div>
            </div>

            <!-- Balloon Shape Resize & Auto-Fit Capability Deck -->
            <div class="p-3.5 rounded-2xl bg-indigo-50/50 dark:bg-indigo-950/20 border border-indigo-100 dark:border-indigo-900/40 space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-indigo-950 dark:text-indigo-200 flex items-center gap-1.5">
                        <span>📐</span> Balloon Size & Resize:
                    </span>
                    <button type="button"
                            @onclick="ToggleAutoResize"
                            class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold transition-all @(AutoResizeBalloon ? "bg-emerald-600 text-white shadow-xs" : "bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300")"
                            title="Auto-Resize dynamically keeps the backdrop shape generously larger than the word in front of it">
                        @(AutoResizeBalloon ? "Auto-Fit: ON" : "Auto-Fit: OFF")
                    </button>
                </div>

                <!-- Shape Scale Multiplier Slider -->
                <div>
                    <div class="flex justify-between items-center text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">
                        <span>Shape Scale (Bigger/Smaller):</span>
                        <span class="font-mono text-indigo-600 dark:text-indigo-400">@BalloonScale.ToString("F2")x</span>
                    </div>
                    <input type="range"
                           min="0.8"
                           max="2.5"
                           step="0.05"
                           @bind="BalloonScale"
                           @bind:event="oninput"
                           class="w-full accent-indigo-600 cursor-pointer" />
                    <div class="flex justify-between text-[10px] text-slate-400">
                        <span>0.8x (Snug)</span>
                        <span>1.35x (Generous)</span>
                        <span>2.5x (Mega)</span>
                    </div>
                </div>

                <!-- Quick Size Preset Pills & Step Buttons -->
                <div class="flex items-center justify-between gap-1 pt-1">
                    <div class="flex items-center gap-1">
                        <button type="button" @onclick="() => SetBalloonScale(1.0)" class="px-2 py-0.5 text-[10px] font-bold rounded-md border border-slate-200 dark:border-slate-700 hover:bg-white dark:hover:bg-slate-800 transition">1.0x</button>
                        <button type="button" @onclick="() => SetBalloonScale(1.35)" class="px-2 py-0.5 text-[10px] font-bold rounded-md border border-indigo-300 dark:border-indigo-700 bg-white dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 shadow-2xs">1.35x</button>
                        <button type="button" @onclick="() => SetBalloonScale(1.75)" class="px-2 py-0.5 text-[10px] font-bold rounded-md border border-slate-200 dark:border-slate-700 hover:bg-white dark:hover:bg-slate-800 transition">1.75x</button>
                        <button type="button" @onclick="() => SetBalloonScale(2.2)" class="px-2 py-0.5 text-[10px] font-bold rounded-md border border-slate-200 dark:border-slate-700 hover:bg-white dark:hover:bg-slate-800 transition">2.2x</button>
                    </div>
                    <div class="flex items-center gap-1">
                        <button type="button" @onclick="ShrinkBalloon" class="px-2 py-0.5 text-[10px] font-bold rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 transition" title="Shrink shape 10%">➖</button>
                        <button type="button" @onclick="EnlargeBalloon" class="px-2 py-0.5 text-[10px] font-bold rounded-md border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-50 transition" title="Enlarge shape 10%">➕</button>
                    </div>
                </div>

                <!-- Padding Sliders -->
                <div class="grid grid-cols-2 gap-2 pt-1 border-t border-indigo-100 dark:border-indigo-900/30">
                    <div>
                        <div class="flex justify-between items-center text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-0.5">
                            <span>Pad X:</span>
                            <span class="font-mono text-indigo-500">@(Math.Round(BalloonPaddingX))px</span>
                        </div>
                        <input type="range"
                               min="15"
                               max="100"
                               step="2"
                               @bind="BalloonPaddingX"
                               @bind:event="oninput"
                               class="w-full accent-indigo-600 cursor-pointer" />
                    </div>
                    <div>
                        <div class="flex justify-between items-center text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-0.5">
                            <span>Pad Y:</span>
                            <span class="font-mono text-indigo-500">@(Math.Round(BalloonPaddingY))px</span>
                        </div>
                        <input type="range"
                               min="8"
                               max="60"
                               step="2"
                               @bind="BalloonPaddingY"
                               @bind:event="oninput"
                               class="w-full accent-indigo-600 cursor-pointer" />
                    </div>
                </div>

                @if (!AutoResizeBalloon)
                {
                    <div class="pt-2 border-t border-indigo-100 dark:border-indigo-900/30 space-y-2">
                        <span class="text-[10px] uppercase font-bold text-amber-600 dark:text-amber-400 block">Manual Fixed Dimensions:</span>
                        <div>
                            <div class="flex justify-between items-center text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-0.5">
                                <span>Custom Width:</span>
                                <span class="font-mono text-indigo-500">@(BalloonCustomWidth > 0 ? $"{BalloonCustomWidth}px" : "Auto")</span>
                            </div>
                            <input type="range"
                                   min="100"
                                   max="480"
                                   step="10"
                                   @bind="BalloonCustomWidth"
                                   @bind:event="oninput"
                                   class="w-full accent-indigo-600 cursor-pointer" />
                        </div>
                    </div>
                }
            </div>

            <!-- Tail Direction & Style Controls -->
            <div class="space-y-2">
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                    Pointer Tail Direction:
                </label>
                <div class="grid grid-cols-3 gap-1 text-[11px]">
                    <button type="button"
                            @onclick="() => SelectedTailPosition = WordBalloonTailPosition.BottomLeft"
                            class="px-2 py-1 rounded-lg border text-center font-medium @(SelectedTailPosition == WordBalloonTailPosition.BottomLeft ? "bg-indigo-600 text-white font-bold" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700")">
                        Bottom-Left
                    </button>
                    <button type="button"
                            @onclick="() => SelectedTailPosition = WordBalloonTailPosition.BottomCenter"
                            class="px-2 py-1 rounded-lg border text-center font-medium @(SelectedTailPosition == WordBalloonTailPosition.BottomCenter ? "bg-indigo-600 text-white font-bold" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700")">
                        Bottom-Center
                    </button>
                    <button type="button"
                            @onclick="() => SelectedTailPosition = WordBalloonTailPosition.BottomRight"
                            class="px-2 py-1 rounded-lg border text-center font-medium @(SelectedTailPosition == WordBalloonTailPosition.BottomRight ? "bg-indigo-600 text-white font-bold" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700")">
                        Bottom-Right
                    </button>
                    <button type="button"
                            @onclick="() => SelectedTailPosition = WordBalloonTailPosition.TopLeft"
                            class="px-2 py-1 rounded-lg border text-center font-medium @(SelectedTailPosition == WordBalloonTailPosition.TopLeft ? "bg-indigo-600 text-white font-bold" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700")">
                        Top-Left
                    </button>
                    <button type="button"
                            @onclick="() => SelectedTailPosition = WordBalloonTailPosition.TopRight"
                            class="px-2 py-1 rounded-lg border text-center font-medium @(SelectedTailPosition == WordBalloonTailPosition.TopRight ? "bg-indigo-600 text-white font-bold" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700")">
                        Top-Right
                    </button>
                    <button type="button"
                            @onclick="() => SelectedTailPosition = WordBalloonTailPosition.None"
                            class="px-2 py-1 rounded-lg border text-center font-medium @(SelectedTailPosition == WordBalloonTailPosition.None ? "bg-indigo-600 text-white font-bold" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700")">
                        None (Floating)
                    </button>
                </div>
            </div>

            <!-- Typography Effect Selector -->
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-2">
                    Text Typography Effect:
                </label>
                <div class="grid grid-cols-2 gap-1.5 text-xs">
                    <button type="button"
                            @onclick="() => SelectedEffect = WordBalloonEffect.Outlined"
                            class="px-2.5 py-1.5 rounded-lg border text-left flex items-center gap-1.5 @(SelectedEffect == WordBalloonEffect.Outlined ? "border-indigo-600 bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 font-bold" : "border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300")">
                        <span>✏️</span> Outlined Pop
                    </button>
                    <button type="button"
                            @onclick="() => SelectedEffect = WordBalloonEffect.Bold"
                            class="px-2.5 py-1.5 rounded-lg border text-left flex items-center gap-1.5 @(SelectedEffect == WordBalloonEffect.Bold ? "border-indigo-600 bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 font-bold" : "border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300")">
                        <span>🔲</span> Bold Heavy
                    </button>
                    <button type="button"
                            @onclick="() => SelectedEffect = WordBalloonEffect.PowEffect"
                            class="px-2.5 py-1.5 rounded-lg border text-left flex items-center gap-1.5 @(SelectedEffect == WordBalloonEffect.PowEffect ? "border-amber-500 bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 font-bold" : "border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300")">
                        <span>💥</span> POW! 3D Effect
                    </button>
                    <button type="button"
                            @onclick="() => SelectedEffect = WordBalloonEffect.GlitchEffect"
                            class="px-2.5 py-1.5 rounded-lg border text-left flex items-center gap-1.5 @(SelectedEffect == WordBalloonEffect.GlitchEffect ? "border-cyan-500 bg-cyan-50 dark:bg-cyan-950/40 text-cyan-600 dark:text-cyan-400 font-bold" : "border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300")">
                        <span>⚡</span> RGB Glitch
                    </button>
                    <button type="button"
                            @onclick="() => SelectedEffect = WordBalloonEffect.NeonGlow"
                            class="px-2.5 py-1.5 rounded-lg border text-left flex items-center gap-1.5 @(SelectedEffect == WordBalloonEffect.NeonGlow ? "border-cyan-500 bg-cyan-50 dark:bg-cyan-950/40 text-cyan-600 dark:text-cyan-400 font-bold" : "border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300")">
                        <span>✨</span> Neon Glow
                    </button>
                    <button type="button"
                            @onclick="() => SelectedEffect = WordBalloonEffect.GradientChrome"
                            class="px-2.5 py-1.5 rounded-lg border text-left flex items-center gap-1.5 @(SelectedEffect == WordBalloonEffect.GradientChrome ? "border-slate-500 bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-bold" : "border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300")">
                        <span>🪞</span> Chrome Specular
                    </button>
                    <button type="button"
                            @onclick="() => SelectedEffect = WordBalloonEffect.FireFlame"
                            class="px-2.5 py-1.5 rounded-lg border text-left flex items-center gap-1.5 @(SelectedEffect == WordBalloonEffect.FireFlame ? "border-rose-500 bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 font-bold" : "border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300")">
                        <span>🔥</span> Fire Flame
                    </button>
                    <button type="button"
                            @onclick="() => SelectedEffect = WordBalloonEffect.Retro3D"
                            class="px-2.5 py-1.5 rounded-lg border text-left flex items-center gap-1.5 @(SelectedEffect == WordBalloonEffect.Retro3D ? "border-green-500 bg-green-50 dark:bg-green-950/40 text-green-600 dark:text-green-400 font-bold" : "border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300")">
                        <span>🧱</span> Retro 3D Block
                    </button>
                </div>
            </div>
        </div>

        <!-- Column 3: Visual Overlays & Themes -->
        <div class="space-y-4">
            <!-- Overlays Control Deck -->
            <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-850 border border-slate-200 dark:border-slate-800 space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                        <span>🛡️</span> Visual Extras & Overlays:
                    </span>
                    <button type="button"
                            @onclick="ToggleMasterOverlays"
                            class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold transition-colors @(MasterOverlaysEnabled ? "bg-emerald-500/20 text-emerald-600 border border-emerald-500/30" : "bg-slate-200 dark:bg-slate-700 text-slate-500")">
                        @(MasterOverlaysEnabled ? "ALL ON" : "ALL OFF (Clean)")
                    </button>
                </div>

                <div class="space-y-2 text-xs">
                    <label class="flex items-center justify-between cursor-pointer">
                        <span class="text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                            <span>⚡</span> Speed Sunburst Rays
                        </span>
                        <input type="checkbox"
                               @bind="ShowSpeedSunburst"
                               disabled="@(!MasterOverlaysEnabled)"
                               class="rounded-sm border-slate-300 text-indigo-600 focus:ring-indigo-500 disabled:opacity-50" />
                    </label>

                    <label class="flex items-center justify-between cursor-pointer">
                        <span class="text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                            <span>🔴</span> Pop-Art Halftone Dots
                        </span>
                        <input type="checkbox"
                               @bind="ShowHalftoneDots"
                               disabled="@(!MasterOverlaysEnabled)"
                               class="rounded-sm border-slate-300 text-indigo-600 focus:ring-indigo-500 disabled:opacity-50" />
                    </label>

                    <label class="flex items-center justify-between cursor-pointer">
                        <span class="text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                            <span>✨</span> Action Stars & Sparks
                        </span>
                        <input type="checkbox"
                               @bind="ShowActionSparks"
                               disabled="@(!MasterOverlaysEnabled)"
                               class="rounded-sm border-slate-300 text-indigo-600 focus:ring-indigo-500 disabled:opacity-50" />
                    </label>

                    <label class="flex items-center justify-between cursor-pointer">
                        <span class="text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                            <span>🪞</span> Specular Gloss Sheen
                        </span>
                        <input type="checkbox"
                               @bind="ShowSpecularSheen"
                               disabled="@(!MasterOverlaysEnabled)"
                               class="rounded-sm border-slate-300 text-indigo-600 focus:ring-indigo-500 disabled:opacity-50" />
                    </label>

                    <label class="flex items-center justify-between cursor-pointer">
                        <span class="text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
                            <span>🖥️</span> Cyber Scanlines HUD
                        </span>
                        <input type="checkbox"
                               @bind="ShowScanlineHud"
                               disabled="@(!MasterOverlaysEnabled)"
                               class="rounded-sm border-slate-300 text-indigo-600 focus:ring-indigo-500 disabled:opacity-50" />
                    </label>
                </div>
            </div>

            <!-- Color Theme Selector -->
            <div>
                <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-2">
                    Color Palette Theme:
                </label>
                <div class="space-y-1.5 max-h-[190px] overflow-y-auto p-1 border border-slate-100 dark:border-slate-800 rounded-xl">
                    <button type="button"
                            @onclick="() => SelectedTheme = WordBalloonTheme.ComicYellow"
                            class="w-full px-3 py-1.5 rounded-lg text-xs font-semibold border flex items-center justify-between transition-all @(SelectedTheme == WordBalloonTheme.ComicYellow ? "border-amber-500 bg-amber-50 dark:bg-amber-950/30 font-bold" : "border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300")">
                        <div class="flex items-center gap-2">
