    /// <summary>
    /// 1-Click clean normal word balloon: turns off all extras, sets word count to 0,
    /// turns off all overlays, and paints the center word strictly on top.
    /// </summary>
    public void SetCleanNormalBalloon()
    {
        CurrentPreset = "NORMAL";
        SelectedShape = WordBalloonShape.SpeechBubble;
        SelectedEffect = WordBalloonEffect.Outlined;
        SelectedTheme = WordBalloonTheme.IndigoViolet;
        MainWord = "Hello Blazor!";
        KickerText = "";
        SurroundingWordCount = 0;
        WordScale = 1.25;
        WordTiltAngle = 0;
        AnimatePulse = false;
        CenterWordOnTop = true;
        AutoResizeBalloon = true;
        BalloonScale = 1.35;
        BalloonPaddingX = 42.0;
        BalloonPaddingY = 22.0;
        BalloonCustomWidth = 0.0;

        MasterOverlaysEnabled = false;
        ShowSpeedSunburst = false;
        ShowHalftoneDots = false;
        ShowActionSparks = false;
        ShowSpecularSheen = false;
        ShowScanlineHud = false;
    }

    public void ToggleMasterOverlays()
    {
        MasterOverlaysEnabled = !MasterOverlaysEnabled;
        if (MasterOverlaysEnabled)
        {
            ShowSpeedSunburst = true;
            ShowHalftoneDots = true;
            ShowActionSparks = true;
        }
    }

    private void ApplyPreset(string presetKey, WordBalloonShape shape, WordBalloonEffect effect, WordBalloonTheme theme,
                             string word, bool animate, bool overlaysEnabled, int wordCount,
                             bool sunburst = false, bool halftone = false, bool sparks = false, bool sheen = false, bool scanline = false,
                             string kicker = "")
    {
        CurrentPreset = presetKey;
        SelectedShape = shape;
        SelectedEffect = effect;
        SelectedTheme = theme;
        MainWord = word;
        AnimatePulse = animate;
        MasterOverlaysEnabled = overlaysEnabled;
        SurroundingWordCount = wordCount;
        ShowSpeedSunburst = sunburst;
        ShowHalftoneDots = halftone;
        ShowActionSparks = sparks;
        ShowSpecularSheen = sheen;
        ShowScanlineHud = scanline;
        KickerText = kicker;
        CenterWordOnTop = true;
    }

    private void RandomizeWord()
    {
        var rnd = new Random();
        MainWord = SurpriseWords[rnd.Next(SurpriseWords.Length)];
        CurrentPreset = "CUSTOM";
    }

    private async Task CopySvgMarkup()
    {
        var svg = GenerateStandaloneSvgString();
        try
        {
            await JS.InvokeAsync<bool>("clipboardHelper.copyText", svg);
            _copyConfirmed = true;
            StateHasChanged();
            await Task.Delay(2500);
            _copyConfirmed = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clipboard error: {ex.Message}");
            _copyConfirmed = true;
            StateHasChanged();
            await Task.Delay(2500);
            _copyConfirmed = false;
            StateHasChanged();
        }
    }

    private async Task CopyBlazorSnippet()
    {
        var snippet = $"<TwWordBalloonOverlay Text=\"{MainWord}\" Shape=\"WordBalloonShape.{SelectedShape}\" Theme=\"WordBalloonTheme.{SelectedTheme}\" Effect=\"WordBalloonEffect.{SelectedEffect}\">\n    <button class=\"btn\">Anchor Target</button>\n</TwWordBalloonOverlay>";
        try
        {
            await JS.InvokeAsync<bool>("clipboardHelper.copyText", snippet);
            _copyConfirmed = true;
            StateHasChanged();
            await Task.Delay(2500);
            _copyConfirmed = false;
            StateHasChanged();
        }
        catch { }
    }

    private async Task ExportSvgFile()
    {
        var svg = GenerateStandaloneSvgString();
        var safeName = string.Concat((string.IsNullOrWhiteSpace(MainWord) ? "word-balloon" : MainWord).Split(Path.GetInvalidFileNameChars())).Replace(" ", "-").ToLowerInvariant();
        _downloadedFilename = $"{safeName}-balloon.svg";

        await JS.InvokeVoidAsync("pdfHelper.downloadText", _downloadedFilename, "image/svg+xml", svg);
        _downloadConfirmed = true;
        StateHasChanged();
        await Task.Delay(3000);
        _downloadConfirmed = false;
        StateHasChanged();
    }

    private async Task ExportPngFile()
    {
        var svg = GenerateStandaloneSvgString();
        var safeName = string.Concat((string.IsNullOrWhiteSpace(MainWord) ? "word-balloon" : MainWord).Split(Path.GetInvalidFileNameChars())).Replace(" ", "-").ToLowerInvariant();
        _downloadedFilename = $"{safeName}-balloon.png";

        await JS.InvokeVoidAsync("pdfHelper.downloadSvgAsPng", _downloadedFilename, svg, 640, 320);
        _downloadConfirmed = true;
        StateHasChanged();
        await Task.Delay(3000);
        _downloadConfirmed = false;
        StateHasChanged();
    }

    private string GenerateStandaloneSvgString()
    {
        var sb = new StringBuilder();
        var safeText = System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(MainWord) ? "BLAZOR" : MainWord);
        var fontSize = Math.Round(42 * Math.Clamp(WordScale, 0.6, 2.0));
        var approxCharWidth = fontSize * 0.52;
        var pillWidth = Math.Max(95.0, (safeText.Length * approxCharWidth) + 26.0);
        var pillHeight = fontSize * 1.45;
        double cx = 320.0;
        double cy = 160.0;

        sb.AppendLine(@"<?xml version=""1.0"" encoding=""UTF-8""?>");
        sb.AppendLine(@"<svg xmlns=""http://www.w3.org/2000/svg"" viewBox=""0 0 640 320"" width=""640"" height=""320"">");
        sb.AppendLine(@"  <defs>");
        sb.AppendLine(@"    <filter id=""shadow"" x=""-30%"" y=""-30%"" width=""160%"" height=""160%""><feDropShadow dx=""3"" dy=""4"" stdDeviation=""4"" flood-color=""#000000"" flood-opacity=""0.4""/></filter>");
        sb.AppendLine(@"    <linearGradient id=""bgGrad"" x1=""0%"" y1=""0%"" x2=""100%"" y2=""100%"">");
        
        if (SelectedTheme == WordBalloonTheme.ComicYellow)
        {
            sb.AppendLine(@"      <stop offset=""0%"" stop-color=""#fef08a""/><stop offset=""100%"" stop-color=""#facc15""/>");
        }
        else if (SelectedTheme == WordBalloonTheme.CrimsonBurst)
        {
            sb.AppendLine(@"      <stop offset=""0%"" stop-color=""#ef4444""/><stop offset=""100%"" stop-color=""#f97316""/>");
        }
        else if (SelectedTheme == WordBalloonTheme.CyberCyan)
        {
            sb.AppendLine(@"      <stop offset=""0%"" stop-color=""#0891b2""/><stop offset=""100%"" stop-color=""#06b6d4""/>");
        }
        else if (SelectedTheme == WordBalloonTheme.EmeraldTech)
        {
            sb.AppendLine(@"      <stop offset=""0%"" stop-color=""#059669""/><stop offset=""100%"" stop-color=""#10b981""/>");
        }
        else if (SelectedTheme == WordBalloonTheme.SunsetBlaze)
        {
            sb.AppendLine(@"      <stop offset=""0%"" stop-color=""#ec4899""/><stop offset=""100%"" stop-color=""#f97316""/>");
        }
        else if (SelectedTheme == WordBalloonTheme.GoldenHero)
        {
            sb.AppendLine(@"      <stop offset=""0%"" stop-color=""#78350f""/><stop offset=""100%"" stop-color=""#fde68a""/>");
        }
        else if (SelectedTheme == WordBalloonTheme.NeonMatrix)
        {
            sb.AppendLine(@"      <stop offset=""0%"" stop-color=""#022c22""/><stop offset=""100%"" stop-color=""#22c55e""/>");
        }
        else if (SelectedTheme == WordBalloonTheme.MonochromeNoir)
        {
            sb.AppendLine(@"      <stop offset=""0%"" stop-color=""#0f172a""/><stop offset=""100%"" stop-color=""#334155""/>");
        }
        else
        {
            sb.AppendLine(@"      <stop offset=""0%"" stop-color=""#4338ca""/><stop offset=""100%"" stop-color=""#6366f1""/>");
        }
        sb.AppendLine(@"    </linearGradient>");
        sb.AppendLine(@"  </defs>");

        // Background Backdrop
        sb.AppendLine(@"  <rect width=""100%"" height=""100%"" fill=""#0f172a"" rx=""16""/>");

        // Sunburst Rays if active
        if (MasterOverlaysEnabled && ShowSpeedSunburst)
        {
            sb.AppendLine(@"  <g opacity=""0.25"">");
            double step = (2 * Math.PI) / 24;
            for (int i = 0; i < 24; i += 2)
            {
                double a1 = i * step;
                double a2 = (i + 1) * step;
                double p1x = cx + 380 * Math.Cos(a1);
                double p1y = cy + 380 * Math.Sin(a1);
                double p2x = cx + 380 * Math.Cos(a2);
                double p2y = cy + 380 * Math.Sin(a2);
                sb.AppendLine($@"    <polygon points=""{cx:F1},{cy:F1} {p1x:F1},{p1y:F1} {p2x:F1},{p2y:F1}"" fill=""#facc15""/>");
            }
            sb.AppendLine(@"  </g>");
        }

        // Balloon Shape
        if (SelectedShape == WordBalloonShape.ComicBurst)
        {
            var points = GenerateBurstPointsString(cx, cy, pillWidth, pillHeight);
            sb.AppendLine($@"  <polygon points=""{points}"" fill=""url(#bgGrad)"" stroke=""#000000"" stroke-width=""3.5"" stroke-linejoin=""round"" filter=""url(#shadow)""/>");
        }
        else if (SelectedShape == WordBalloonShape.SpeechBubble || SelectedShape == WordBalloonShape.SmoothCallout)
        {
            var d = GenerateSpeechPathString(cx, cy, pillWidth, pillHeight);
            sb.AppendLine($@"  <path d=""{d}"" fill=""url(#bgGrad)"" stroke=""#6366f1"" stroke-width=""2.5"" stroke-linejoin=""round"" filter=""url(#shadow)""/>");
        }
        else if (SelectedShape == WordBalloonShape.BadgeShield)
        {
            var x = cx - (pillWidth / 2.0);
            var y = cy - (pillHeight / 2.0);
            sb.AppendLine($@"  <path d=""M {x:F1},{y + 8:F1} Q {cx:F1},{y - 8:F1} {x + pillWidth:F1},{y + 8:F1} V {y + (pillHeight * 0.58):F1} Q {x + pillWidth:F1},{y + (pillHeight * 0.96):F1} {cx:F1},{y + pillHeight + 10:F1} Q {x:F1},{y + (pillHeight * 0.96):F1} {x:F1},{y + (pillHeight * 0.58):F1} Z"" fill=""url(#bgGrad)"" stroke=""#000000"" stroke-width=""2.5"" filter=""url(#shadow)""/>");
        }
        else
        {
            var px = cx - (pillWidth / 2.0);
            var py = cy - (pillHeight / 2.0);
            sb.AppendLine($@"  <rect x=""{px.ToString("F1", CultureInfo.InvariantCulture)}"" y=""{py.ToString("F1", CultureInfo.InvariantCulture)}"" width=""{pillWidth.ToString("F1", CultureInfo.InvariantCulture)}"" height=""{pillHeight.ToString("F1", CultureInfo.InvariantCulture)}"" rx=""{(pillHeight / 2.0).ToString("F1", CultureInfo.InvariantCulture)}"" fill=""url(#bgGrad)"" stroke=""#6366f1"" stroke-width=""2"" filter=""url(#shadow)""/>");
        }

        // Kicker Badge if present
        if (MasterOverlaysEnabled && !string.IsNullOrWhiteSpace(KickerText))
        {
            var kx = cx - (pillWidth * 0.35);
            var ky = cy - (pillHeight * 0.55);
            var kw = (KickerText.Length * 7.5) + 16.0;
            sb.AppendLine($@"  <g transform=""rotate(-6 {kx:F1} {ky:F1})"">");
            sb.AppendLine($@"    <rect x=""{(kx - 4):F1}"" y=""{(ky - 10):F1}"" width=""{kw:F1}"" height=""18"" rx=""4"" fill=""#ef4444"" stroke=""#000000"" stroke-width=""2""/>");
            sb.AppendLine($@"    <text x=""{(kx - 4 + kw / 2.0):F1}"" y=""{(ky - 1):F1}"" font-family=""system-ui, sans-serif"" font-size=""9"" font-weight=""900"" text-anchor=""middle"" dominant-baseline=""central"" fill=""#ffffff"">{System.Net.WebUtility.HtmlEncode(KickerText)}</text>");
            sb.AppendLine(@"  </g>");
        }

        // Center Word Text (Strictly On Top)
        var rotStr = (WordTiltAngle != 0) ? $@" transform=""rotate({WordTiltAngle:F1} {cx} {cy})""" : "";
        if (SelectedEffect == WordBalloonEffect.PowEffect)
        {
            sb.AppendLine($@"  <text x=""{(cx + 3.5).ToString("F1", CultureInfo.InvariantCulture)}"" y=""{(cy + 3.5).ToString("F1", CultureInfo.InvariantCulture)}"" font-family=""system-ui, sans-serif"" font-size=""{fontSize}"" font-weight=""900"" text-anchor=""middle"" dominant-baseline=""central"" fill=""#000000"" transform=""rotate(-5 {cx} {cy})"">{safeText}</text>");
            sb.AppendLine($@"  <text x=""{cx.ToString("F1", CultureInfo.InvariantCulture)}"" y=""{cy.ToString("F1", CultureInfo.InvariantCulture)}"" font-family=""system-ui, sans-serif"" font-size=""{fontSize}"" font-weight=""900"" text-anchor=""middle"" dominant-baseline=""central"" fill=""#facc15"" stroke=""#000000"" stroke-width=""4"" stroke-linejoin=""round"" font-style=""italic"" transform=""rotate(-5 {cx} {cy})"">{safeText}</text>");
        }
        else
        {
            sb.AppendLine($@"  <text x=""{cx.ToString("F1", CultureInfo.InvariantCulture)}"" y=""{cy.ToString("F1", CultureInfo.InvariantCulture)}"" font-family=""system-ui, sans-serif"" font-size=""{fontSize}"" font-weight=""900"" text-anchor=""middle"" dominant-baseline=""central"" fill=""#ffffff"" stroke=""#0f172a"" stroke-width=""2.5"" stroke-linejoin=""round""{rotStr}>{safeText}</text>");
        }

        sb.AppendLine(@"</svg>");
        return sb.ToString();
    }

    private string GenerateBurstPointsString(double cx, double cy, double w, double h)
    {
        int points = 18;
        var sb = new StringBuilder();
        double rxOuter = (w / 2.0) * 1.25;
        double ryOuter = (h / 2.0) * 1.45;
        double rxInner = (w / 2.0) * 0.72;
        double ryInner = (h / 2.0) * 0.72;

        for (int i = 0; i < points; i++)
        {
            double angle = (i * 2 * Math.PI) / points - (Math.PI / 2);
            double rX = (i % 2 == 0) ? rxOuter : rxInner;
            double rY = (i % 2 == 0) ? ryOuter : ryInner;
            double px = cx + (rX * Math.Cos(angle));
            double py = cy + (rY * Math.Sin(angle));
            sb.Append(CultureInfo.InvariantCulture, $"{px:F1},{py:F1} ");
        }
        return sb.ToString().Trim();
    }

    private string GenerateSpeechPathString(double cx, double cy, double w, double h)
    {
        double x = cx - (w / 2.0);
        double y = cy - (h / 2.0);
        double r = Math.Min(16.0, h / 2.5);
        double tailW = 16.0;
        double tailH = 14.0;
        double tailX = (SelectedTailPosition == WordBalloonTailPosition.BottomRight) ? x + (w * 0.75) : x + (w * 0.25);

        if (SelectedTailPosition == WordBalloonTailPosition.None)
        {
            return string.Create(CultureInfo.InvariantCulture,
                $"M {x + r:F1},{y:F1} H {x + w - r:F1} Q {x + w:F1},{y:F1} {x + w:F1},{y + r:F1} V {y + h - r:F1} Q {x + w:F1},{y + h:F1} {x + w - r:F1},{y + h:F1} H {x + r:F1} Q {x:F1},{y + h:F1} {x:F1},{y + h - r:F1} V {y + r:F1} Q {x:F1},{y:F1} {x + r:F1},{y:F1} Z");
        }

        return string.Create(CultureInfo.InvariantCulture,
            $"M {x + r:F1},{y:F1} H {x + w - r:F1} Q {x + w:F1},{y:F1} {x + w:F1},{y + r:F1} V {y + h - r:F1} Q {x + w:F1},{y + h:F1} {x + w - r:F1},{y + h:F1} H {tailX + tailW:F1} L {tailX:F1},{y + h + tailH:F1} L {tailX - (tailW * 0.3):F1},{y + h:F1} H {x + r:F1} Q {x:F1},{y + h:F1} {x:F1},{y + h - r:F1} V {y + r:F1} Q {x:F1},{y:F1} {x + r:F1},{y:F1} Z");
    }
}
