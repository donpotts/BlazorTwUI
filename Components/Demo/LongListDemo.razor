@using System.Diagnostics
@* Long lists: 20,000 grid rows and 5,000 picker options. Only the rows on screen are in the page; search, sort and selection still cover all of them. *@
<section class="space-y-6" data-testid="long-list-demo" aria-labelledby="long-list-title">
    <header>
        <h2 id="long-list-title" class="text-xl font-black text-slate-900 dark:text-white">Long lists</h2>
        <p class="text-sm text-slate-700 dark:text-slate-300 mt-1 max-w-3xl">
            A grid of 20,000 shipments and pickers with 5,000 suppliers and 5,000 tags. Scroll, search and sort as usual:
            only the rows you can see are drawn, so the page stays quick however long the list is.
        </p>
    </header>

    <TwDataGrid TItem="Shipment" Items="_shipments" Label="Shipments" Title="Shipments" Selectable="true" MaxHeight="28rem" SearchPlaceholder="Search shipments...">
        <Columns>
            <TwDataGridColumn TItem="Shipment" Title="Shipment" Property="s => s.Id" Width="120px" />
            <TwDataGridColumn TItem="Shipment" Title="Supplier" Property="s => s.Supplier" MinWidth="200px" />
            <TwDataGridColumn TItem="Shipment" Title="City" Property="s => s.City" />
            <TwDataGridColumn TItem="Shipment" Title="Weight (kg)" Align="right" Property="s => s.Weight" />
        </Columns>
        <ActionsTemplate Context="s">
            <button type="button" class="px-3 min-h-[36px] rounded-lg border border-slate-300 dark:border-slate-600 text-xs font-semibold text-slate-900 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800">Open</button>
        </ActionsTemplate>
    </TwDataGrid>

    <div class="grid gap-6 lg:grid-cols-2">
        <div class="space-y-2">
            <TwRelationPicker Relation="_supplier" LoadOptions="LoadOptions" SelectedIdsChanged="ids => _supplierIds = ids" />
            <p class="text-xs text-slate-700 dark:text-slate-300" data-testid="long-list-supplier">Supplier id: @(_supplierIds.FirstOrDefault() ?? "none")</p>
        </div>
        <div class="space-y-2">
            <TwRelationPicker Relation="_tags" LoadOptions="LoadOptions" SelectedIdsChanged="ids => _tagIds = ids" />
            <p class="text-xs text-slate-700 dark:text-slate-300" data-testid="long-list-tags">@_tagIds.Count tags chosen</p>
        </div>
    </div>
</section>

@code {
    private sealed record Shipment(string Id, string Supplier, string City, int Weight);

    private static readonly string[] Cities = { "Austin", "Boston", "Denver", "Fresno", "Lisbon", "Madrid", "Nairobi", "Osaka", "Perth", "Quebec", "Toronto", "Zurich" };
    private static readonly string[] Words = { "Alpine", "Harbor", "Cedar", "Summit", "Prairie", "Coastal", "Granite", "Maple", "Juniper", "Willow" };
    private static readonly string[] Kinds = { "Supply", "Freight", "Traders", "Goods", "Outfitters", "Logistics", "Works", "Partners" };

    private readonly List<Shipment> _shipments = Enumerable.Range(1, 20000)
        .Select(i => new Shipment($"SH-{i:D5}", SupplierName(i % 5000 + 1), Cities[i % Cities.Length], 5 + (i * 37) % 900)).ToList();

    private readonly EntityRelation _supplier = new("supplier", "Supplier", RelationKind.One, "Supplier");
    private readonly EntityRelation _tags = new("tags", "Tags", RelationKind.Many, "Tag");
    private IReadOnlyList<string> _supplierIds = Array.Empty<string>();
    private IReadOnlyList<string> _tagIds = Array.Empty<string>();

    private static string SupplierName(int i) => $"{Words[i % Words.Length]} {Kinds[(i / Words.Length) % Kinds.Length]} {i:D4}";

    private static Task<IReadOnlyList<(string Id, string Name)>> LoadOptions(string target)
    {
        IReadOnlyList<(string, string)> list = target == "Supplier"
            ? Enumerable.Range(1, 5000).Select(i => (i.ToString(), SupplierName(i))).ToList()
            : Enumerable.Range(1, 5000).Select(i => (i.ToString(), $"Tag {i:D4}")).ToList();
        return Task.FromResult(list);
    }
}
